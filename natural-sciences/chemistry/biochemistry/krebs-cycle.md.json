  "concepts": [
    {
      "term": "Krebs cycle",
      "anchor": "#definition",
      "definition": "The cycle in the mitochondrial matrix that oxidizes acetyl groups to CO2 and produces NADH, FADH2 and GTP."
    },
    {
      "term": "Anaplerotic reaction",
      "anchor": "#a-hub-not-only-a-furnace",
      "definition": "A reaction that refills intermediates of the Krebs cycle."
    },
    {
      "term": "Pyruvate dehydrogenase",
      "anchor": "#mechanism",
      "definition": "The enzyme complex that converts pyruvate into acetyl-CoA before the cycle."
    }
  ],
  "questions": [
    {
      "id": "q1",
      "type": "apply",
      "q": "A diet very low in thiamine impairs energy production from carbohydrate. Why?",
      "a": "Thiamine pyrophosphate is a coenzyme of pyruvate dehydrogenase and alpha-ketoglutarate dehydrogenase.",
      "anchor": "#mechanism",
      "origin": "ai",
      "reviewed": false
    },
    {
      "id": "q2",
      "type": "recall",
      "q": "How many times does the cycle turn per glucose?",
      "a": "Twice, once for each acetyl-CoA.",
      "anchor": "#mechanism",
      "origin": "ai",
      "reviewed": false
    }
  ],
