    {
      "term": "Electron transport chain",
      "anchor": "#mechanism",
      "definition": "The four protein complexes and two carriers in the inner mitochondrial membrane that pass electrons to oxygen."
    },
    {
      "term": "Chemiosmotic theory",
      "anchor": "#definition",
      "definition": "The idea that a proton gradient couples electron transport to ATP synthesis."
    },
    {
      "term": "Uncoupling",
      "anchor": "#what-stops-it",
      "definition": "Proton leak across the membrane that bypasses ATP synthase and releases the energy as heat."
    }
