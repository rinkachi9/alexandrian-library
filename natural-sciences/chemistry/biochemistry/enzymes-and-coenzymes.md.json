    {
      "term": "Enzyme",
      "anchor": "#definition",
      "definition": "A biological catalyst, usually a protein, that speeds up a specific reaction by lowering its activation energy."
    },
    {
      "term": "Coenzyme",
      "anchor": "#definition",
      "definition": "A small organic cofactor that carries electrons or chemical groups between enzymes."
    },
    {
      "term": "Michaelis constant",
      "anchor": "#mechanism",
      "definition": "The substrate concentration at which an enzyme works at half its maximum rate."
    }
