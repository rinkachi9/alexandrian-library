    {
      "term": "ATP",
      "anchor": "#definition",
      "definition": "Adenosine triphosphate, the nucleotide whose hydrolysis to ADP pays for most cellular work."
    },
    {
      "term": "Phosphocreatine",
      "anchor": "#systems-that-regenerate-atp",
      "definition": "A store of phosphate groups in muscle that regenerates ATP within seconds through creatine kinase."
    },
    {
      "term": "AMPK",
      "anchor": "#systems-that-regenerate-atp",
      "definition": "An enzyme that senses a rise in AMP and switches the cell towards catabolism."
    }
