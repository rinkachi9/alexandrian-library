    {
      "term": "Free radical",
      "anchor": "#definition",
      "definition": "An atom or molecule with an unpaired electron, which makes it highly reactive."
    },
    {
      "term": "Oxidative stress",
      "anchor": "#definition",
      "definition": "A state in which reactive oxygen species exceed the antioxidant defenses and cause damage."
    },
    {
      "term": "Hormesis",
      "anchor": "#hormesis-and-exercise",
