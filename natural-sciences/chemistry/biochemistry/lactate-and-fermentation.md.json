    {
      "term": "Fermentation",
      "anchor": "#definition",
      "definition": "Regeneration of NAD+ by transferring electrons from NADH to an organic product of pyruvate, without oxygen."
    },
    {
      "term": "Cori cycle",
      "anchor": "#mechanism",
      "definition": "Lactate from muscle is turned into glucose in the liver and returned to the muscle."
    },
    {
      "term": "Lactate shuttle",
      "anchor": "#mechanism",
      "definition": "Movement of lactate between cells and tissues where it is used as fuel."
    }
