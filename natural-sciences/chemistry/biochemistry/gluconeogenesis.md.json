  "questions": [
    {
      "id": "q1",
      "type": "explain",
      "q": "Why does gluconeogenesis need different enzymes than glycolysis at three points?",
      "a": "Three glycolysis steps are irreversible in the cell, so separate bypass enzymes are needed, which also allows separate control.",
      "anchor": "#mechanism",
      "origin": "ai",
      "reviewed": false
    },
    {
      "id": "q2",
      "type": "recall",
      "q": "Which organs perform gluconeogenesis?",
      "a": "Mainly the liver, and to a smaller extent the kidneys.",
