    {
      "term": "Gluconeogenesis",
      "anchor": "#definition",
      "definition": "Synthesis of glucose from lactate, glycerol and amino acids, mainly in the liver."
    },
    {
      "term": "Glucogenic amino acid",
      "anchor": "#mechanism",
      "definition": "An amino acid whose carbon skeleton can be turned into glucose."
    }
