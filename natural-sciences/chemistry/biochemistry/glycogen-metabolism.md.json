  "concepts": [
    {
      "term": "Glycogen",
      "anchor": "#definition",
      "definition": "A branched polymer of glucose that stores carbohydrate in the liver and muscles."
    },
    {
      "term": "Glycogenolysis",
      "anchor": "#mechanism",
      "definition": "Breakdown of glycogen to glucose-1-phosphate by glycogen phosphorylase."
    },
    {
      "term": "Glucose-6-phosphatase",
      "anchor": "#mechanism",
      "definition": "The liver enzyme that frees glucose for release into the blood."
    }
  ],
  "questions": [
    {
      "id": "q1",
      "type": "apply",
      "q": "A runner eats no carbohydrate in a marathon and slows sharply at 30 km. What happened?",
      "a": "Muscle and liver glycogen ran low, so the runner had to rely more on slower fat oxidation.",
      "anchor": "#worked-example",
      "origin": "ai",
      "reviewed": false
    },
    {
      "id": "q2",
      "type": "recall",
      "q": "How much glycogen does the liver typically store?",
      "a": "About 80 to 100 g in an adult.",
      "anchor": "#stores",
      "origin": "ai",
      "reviewed": false
    }
