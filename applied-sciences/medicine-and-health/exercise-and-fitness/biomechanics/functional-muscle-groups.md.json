  "concepts": [
    {
      "term": "Agonist",
      "anchor": "#definition",
      "definition": "The muscle that produces a movement."
    },
    {
      "term": "Antagonist",
      "anchor": "#definition",
      "definition": "A muscle whose action opposes the movement."
    },
    {
      "term": "Synergist",
      "anchor": "#definition",
      "definition": "A muscle that assists the agonist or stabilizes the joint."
    },
    {
      "term": "Reciprocal inhibition",
      "anchor": "#definition",
      "definition": "Reflex relaxation of the antagonist when the agonist contracts."
    }
  ],
  "questions": [
    {
      "id": "q1",
      "type": "explain",
      "q": "Why are chest and back often trained in the same session?",
      "a": "They are antagonists, so their fatigue interferes little, and reciprocal inhibition may help.",
