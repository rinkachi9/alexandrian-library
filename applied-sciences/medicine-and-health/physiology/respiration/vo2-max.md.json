  "concepts": [
    {
      "term": "VO2 max",
      "anchor": "#definition",
      "definition": "The maximal rate of oxygen uptake and use during exhaustive exercise."
    },
    {
      "term": "Fick equation",
      "anchor": "#definition",
      "definition": "Oxygen uptake equals cardiac output times the arteriovenous oxygen difference."
    },
    {
      "term": "Cardiac output",
      "anchor": "#mechanism",
      "definition": "Heart rate times stroke volume, the amount of blood pumped per minute."
    }
