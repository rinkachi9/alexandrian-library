  "concepts": [
    {
      "term": "Lactate threshold",
      "anchor": "#definition",
      "definition": "The intensity at which blood lactate starts to rise faster than it is cleared."
    },
    {
      "term": "OBLA",
      "anchor": "#definition",
      "definition": "Onset of blood lactate accumulation, a fixed reference at 4 mmol/L."
    },
    {
      "term": "Maximal lactate steady state",
      "anchor": "#definition",
      "definition": "The highest intensity at which blood lactate stays stable."
    }
  ],
