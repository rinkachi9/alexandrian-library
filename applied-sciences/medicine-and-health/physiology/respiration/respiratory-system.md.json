    {
      "term": "Alveoli",
      "anchor": "#definition",
      "definition": "Tiny air sacs where oxygen and carbon dioxide are exchanged."
    },
    {
      "term": "Dead space",
      "anchor": "#mechanism",
      "definition": "Air in the conducting airways that does not take part in gas exchange."
    },
    {
      "term": "Surfactant",
      "anchor": "#mechanism",
      "definition": "A substance that lowers surface tension in the alveoli."
    }
