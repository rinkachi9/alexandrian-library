    {
      "term": "Sarcomere",
      "anchor": "#definition",
      "definition": "The repeating contractile unit of a myofibril between two Z discs."
    },
    {
      "term": "T-tubule",
      "anchor": "#mechanism",
      "definition": "An inward fold of the muscle cell membrane that carries the action potential into the fiber."
    },
    {
      "term": "Sarcoplasmic reticulum",
      "anchor": "#mechanism",
      "definition": "The membrane network that stores and releases calcium in muscle fibers."
    }
