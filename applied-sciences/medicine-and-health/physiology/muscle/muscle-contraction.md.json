  "concepts": [
    {
      "term": "Sliding filament theory",
      "anchor": "#definition",
      "definition": "Muscles shorten because actin and myosin filaments slide past each other."
    },
    {
      "term": "Cross-bridge cycle",
      "anchor": "#mechanism",
      "definition": "The repeated binding, power stroke and release of myosin heads on actin, powered by ATP."
    },
    {
      "term": "Excitation-contraction coupling",
      "anchor": "#definition",
      "definition": "The sequence linking the muscle action potential to calcium release and contraction."
    }
