    {
      "term": "Flexion",
      "anchor": "#mechanism",
      "definition": "A movement that decreases the angle between two segments in the sagittal plane."
    },
    {
      "term": "Abduction",
      "anchor": "#mechanism",
      "definition": "Movement away from the midline in the frontal plane."
    },
    {
      "term": "Pronation and supination",
      "anchor": "#mechanism",
      "definition": "Rotation of the forearm turning the palm down or up."
    }
  ],
  "questions": [
    {
      "id": "q1",
      "type": "compare",
      "q": "What is the difference between shoulder flexion and shoulder abduction?",
      "a": "Flexion raises the arm forward in the sagittal plane; abduction raises it to the side in the frontal plane.",
