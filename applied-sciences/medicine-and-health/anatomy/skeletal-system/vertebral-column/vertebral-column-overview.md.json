  "concepts": [
    {
      "term": "Vertebral canal",
      "anchor": "#mechanism",
      "definition": "The channel formed by the vertebral foramina that holds the spinal cord."
    },
    {
      "term": "Lordosis",
      "anchor": "#mechanism",
      "definition": "A curve of the spine that is convex forward, normal in the neck and lower back."
    },
    {
      "term": "Kyphosis",
      "anchor": "#mechanism",
      "definition": "A curve of the spine that is convex backward, normal in the thoracic and sacral regions."
    },
    {
      "term": "Scoliosis",
      "anchor": "#mechanism",
      "definition": "A sideways curvature of the spine."
    }
  ],
