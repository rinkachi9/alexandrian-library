    {
      "term": "Customer acquisition cost",
      "anchor": "#definition",
      "definition": "Total sales and marketing cost in a period divided by new customers acquired."
    },
    {
      "term": "Fully loaded CAC",
      "anchor": "#definition",
      "definition": "CAC including ad spend, salaries, tools, agencies and an overhead share."
    },
    {
      "term": "Blended CAC",
      "anchor": "#mechanism",
      "definition": "CAC averaged across all channels."
