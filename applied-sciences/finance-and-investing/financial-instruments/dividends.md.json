  "concepts": [
    {
      "term": "Dividend yield",
      "anchor": "#definition",
      "definition": "Dividend per share divided by the share price."
    },
    {
      "term": "Payout ratio",
      "anchor": "#definition",
      "definition": "Dividends divided by net income."
    },
    {
      "term": "Ex-dividend date",
      "anchor": "#mechanism-from-decision-to-payment",
      "definition": "The first day the share trades without the right to the dividend."
    }
  ],
  "questions": [
    {
      "id": "q1",
      "type": "explain",
      "q": "Why does the share price fall on the ex-dividend date?",
      "a": "New buyers do not get the dividend and the company has paid out the cash, so value falls by about the payment.",
      "anchor": "#why-a-dividend-does-not-create-value",
      "origin": "author"
    },
    {
      "id": "q2",
      "type": "apply",
      "q": "A share costs 80 and pays 3.2 a year. What is the yield?",
      "a": "4%.",
      "anchor": "#definition",
      "origin": "author"
    }
