  "concepts": [
    {
      "term": "Net asset value",
      "anchor": "#definition",
      "definition": "The value of a fund's assets minus liabilities, divided by the number of units."
    },
    {
      "term": "Authorized participant",
      "anchor": "#how-an-etf-works",
      "definition": "An institution that creates and redeems ETF shares against the basket of assets."
    },
    {
      "term": "Synthetic replication",
      "anchor": "#replication",
      "definition": "Tracking an index with a swap that pays the index return, which adds counterparty risk."
    }
  ],
  "questions": [
    {
      "id": "q1",
      "type": "explain",
      "q": "What keeps an ETF price close to its NAV?",
      "a": "Authorized participants create or redeem shares when the price departs from the value of the basket.",
      "anchor": "#how-an-etf-works",
      "origin": "author"
    },
    {
      "id": "q2",
      "type": "compare",
      "q": "What is the difference between accumulating and distributing funds?",
      "a": "Accumulating funds reinvest income inside the fund, distributing funds pay it out.",
      "anchor": "#what-to-check-before-buying",
      "origin": "author"
    }
