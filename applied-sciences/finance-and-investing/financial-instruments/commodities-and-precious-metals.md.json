  "concepts": [
    {
      "term": "Contango",
      "anchor": "#mechanism-the-roll",
      "definition": "A futures curve where later contracts cost more than earlier ones."
    },
    {
      "term": "Backwardation",
      "anchor": "#mechanism-the-roll",
      "definition": "A futures curve where later contracts cost less than earlier ones."
    },
    {
      "term": "Roll return",
      "anchor": "#mechanism-the-roll",
      "definition": "The gain or loss from replacing an expiring futures contract with the next one."
    }
  ],
