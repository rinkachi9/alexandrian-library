  "concepts": [
    {
      "term": "Yield to maturity",
      "anchor": "#definition",
      "definition": "The single annual rate that makes the present value of the bond's payments equal to its price."
    },
    {
      "term": "Modified duration",
      "anchor": "#definition",
      "definition": "Macaulay duration divided by one plus the yield, the approximate percentage price change per point of yield."
    },
    {
      "term": "Convexity",
      "anchor": "#mechanism",
      "definition": "The curvature of the price-yield relationship, which makes the duration estimate imperfect."
    }
  ],
  "questions": [
    {
      "id": "q1",
      "type": "apply",
      "q": "A bond has a modified duration of 6. How much does it lose if the yield rises 0.5 points?",
      "a": "About 3%.",
      "anchor": "#definition",
      "origin": "author"
    },
    {
      "id": "q2",
      "type": "explain",
      "q": "Why does a zero-coupon bond have a duration equal to its maturity?",
      "a": "All the value arrives at maturity.",
      "anchor": "#mechanism",
      "origin": "author"
    }
  ],
