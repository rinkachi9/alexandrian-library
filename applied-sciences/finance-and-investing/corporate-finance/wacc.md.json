  "concepts": [
    {
      "term": "WACC",
      "anchor": "#definition",
      "definition": "The market-value-weighted average of the after-tax cost of debt and the cost of equity."
    },
    {
      "term": "Tax shield",
      "anchor": "#mechanism",
      "definition": "The reduction in tax from deductible interest, which lowers the effective cost of debt."
    },
    {
      "term": "CAPM",
      "anchor": "#definition",
      "definition": "A model estimating the cost of equity as the risk-free rate plus beta times the market risk premium."
    }
