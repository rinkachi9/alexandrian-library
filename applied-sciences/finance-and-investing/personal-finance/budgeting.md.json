  "concepts": [
    {
      "term": "Budget",
      "anchor": "#definition",
      "definition": "A plan that assigns expected income to expected spending for a defined period."
    },
    {
      "term": "50/30/20 rule",
      "anchor": "#methods",
      "definition": "A split of net income into 50% needs, 30% wants and 20% saving and debt repayment."
    },
    {
      "term": "Static and flexible budget",
      "anchor": "#methods",
      "definition": "A static budget keeps planned amounts fixed, a flexible budget ties some amounts to a driver such as sales."
    }
