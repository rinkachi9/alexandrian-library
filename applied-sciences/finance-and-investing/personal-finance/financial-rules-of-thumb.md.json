  "concepts": [
    {
      "term": "Rule of 72",
      "anchor": "#rule-of-72",
      "definition": "Years to double are about 72 divided by the percentage rate."
    },
    {
      "term": "4% rule",
      "anchor": "#the-4-rule",
      "definition": "A historical result that withdrawing 4% of the starting portfolio, adjusted for inflation, lasted 30 years in US data."
    },
    {
      "term": "Rule of thumb",
      "anchor": "#definition",
      "definition": "A simple decision rule that gives a good-enough answer without detailed analysis."
    }
