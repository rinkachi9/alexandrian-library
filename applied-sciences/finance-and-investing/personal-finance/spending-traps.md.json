  "concepts": [
    {
      "term": "Lifestyle inflation",
      "anchor": "#definition",
      "definition": "A rise in spending that follows a rise in income, so the saving rate does not increase."
    },
    {
      "term": "Paycheck to paycheck",
      "anchor": "#definition",
      "definition": "An informal expression for a household that could not meet its obligations if income stopped briefly."
    },
    {
      "term": "HENRY",
      "anchor": "#definition",
      "definition": "High earner, not rich yet: a household with high income and little saved."
    }
  ],
  "questions": [
    {
      "id": "q1",
      "type": "explain",
      "q": "Why is the latte effect a weak guide for most households?",
      "a": "The amounts are small compared with housing, car and debt costs.",
      "anchor": "#worked-example",
      "origin": "author"
    },
    {
      "id": "q2",
      "type": "apply",
      "q": "How can a raise be protected from lifestyle inflation?",
      "a": "Decide a fixed share to save before the first paycheck and automate the transfer.",
      "anchor": "#mechanism",
      "origin": "author"
    }
