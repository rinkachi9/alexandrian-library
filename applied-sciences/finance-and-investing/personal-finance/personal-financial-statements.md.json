      "term": "Net worth",
      "anchor": "#definition",
      "definition": "Total assets minus total liabilities."
    },
    {
      "term": "Net cash flow",
      "anchor": "#definition",
      "definition": "Cash inflows minus cash outflows over a period."
    },
