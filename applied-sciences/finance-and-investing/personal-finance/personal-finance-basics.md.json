  "concepts": [
    {
      "term": "Personal finance",
      "anchor": "#definition",
      "definition": "The planning and control of the financial resources of an individual or household over time."
    },
    {
      "term": "Financial literacy",
      "anchor": "#definition",
      "definition": "The ability to understand and use concepts such as interest, inflation, risk and diversification to make decisions."
    },
    {
      "term": "Pay yourself first",
      "anchor": "#mechanism-a-priority-order",
      "definition": "Moving the saving amount out on payday so that spending is limited to what remains."
    }
  ],
