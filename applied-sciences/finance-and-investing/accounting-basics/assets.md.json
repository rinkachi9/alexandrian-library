  "concepts": [
    {
      "term": "Asset",
      "anchor": "#definition",
      "definition": "A present economic resource controlled by the entity as a result of past events."
    },
    {
      "term": "Depreciation",
      "anchor": "#measurement",
      "definition": "The spreading of the cost of a tangible asset over its useful life."
    },
    {
      "term": "Impairment",
      "anchor": "#measurement",
      "definition": "A reduction of the carrying amount when it exceeds what the asset can recover."
    }
  ],
  "questions": [
    {
      "id": "q1",
      "type": "recall",
      "q": "What are the three elements of the definition of an asset?",
      "a": "Control, a past event and future economic benefit.",
      "anchor": "#definition",
      "origin": "author"
    },
    {
      "id": "q2",
      "type": "apply",
      "q": "A machine costing 24,000 has a life of 6 years and no residual value. What is its carrying amount after 2 years?",
