  "concepts": [
    {
      "term": "Accounting equation",
      "anchor": "#definition",
      "definition": "Assets equal liabilities plus equity."
    },
    {
      "term": "Equity",
      "anchor": "#definition",
      "definition": "The residual interest in the assets after deducting liabilities."
    }
  ],
  "questions": [
    {
      "id": "q1",
      "type": "apply",
      "q": "A company has assets of 80,000 and liabilities of 50,000. What is its equity?",
      "a": "30,000.",
      "anchor": "#definition",
      "origin": "author"
    },
    {
      "id": "q2",
      "type": "explain",
      "q": "How does a bank loan change the equation?",
      "a": "Assets and liabilities both rise by the loan, and equity does not change.",
      "anchor": "#mechanism",
      "origin": "author"
    }
  ],
