  "concepts": [
    {
      "term": "Accrual accounting",
      "anchor": "#definition",
      "definition": "Recording revenue when earned and expenses when incurred, whatever the payment date."
    },
    {
      "term": "Cash accounting",
      "anchor": "#definition",
      "definition": "Recording revenue and expenses when cash is received or paid."
    },
    {
      "term": "Matching principle",
      "anchor": "#mechanism",
      "definition": "Expenses are recorded in the same period as the revenue they helped to earn."
    }
  ],
  "questions": [
    {
      "id": "q1",
      "type": "apply",
      "q": "A 2,400 annual premium is paid in July. What is the accrual expense for the first six months?",
      "a": "1,200, with 1,200 left as a prepaid expense.",
      "anchor": "#mechanism",
      "origin": "author"
    },
    {
      "id": "q2",
      "type": "explain",
      "q": "Why does accrual profit not show liquidity?",
      "a": "Receivables are earned but not yet cash, so a profitable firm can lack cash.",
      "anchor": "#trade-offs-and-when-to-use-it",
      "origin": "author"
    }
  ],
