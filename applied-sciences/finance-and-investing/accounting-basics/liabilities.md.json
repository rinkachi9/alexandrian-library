  "concepts": [
    {
      "term": "Liability",
      "anchor": "#definition",
      "definition": "A present obligation to transfer an economic resource as a result of past events."
    },
    {
      "term": "Provision",
      "anchor": "#classification-and-types",
      "definition": "A liability of uncertain timing or amount that is recognized."
    },
    {
      "term": "Contingent liability",
      "anchor": "#classification-and-types",
      "definition": "A possible obligation that depends on a future event and is disclosed, not recognized."
    },
    {
      "term": "Deferred revenue",
      "anchor": "#classification-and-types",
      "definition": "Cash received before goods or services are delivered, recorded as a liability."
    }
  ],
  "questions": [
    {
      "id": "q1",
      "type": "explain",
      "q": "Why is deferred revenue a liability and not profit?",
      "a": "The company still owes the service.",
      "anchor": "#classification-and-types",
      "origin": "author"
    },
    {
      "id": "q2",
      "type": "compare",
      "q": "How does a provision differ from a contingent liability?",
      "a": "A provision meets the recognition tests and is recorded, a contingent liability is only disclosed.",
      "anchor": "#classification-and-types",
      "origin": "author"
    }
