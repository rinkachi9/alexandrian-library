  "concepts": [
    {
      "term": "Gross profit",
      "anchor": "#definition",
      "definition": "Revenue minus the cost of goods sold."
    },
    {
      "term": "Net income",
      "anchor": "#definition",
      "definition": "What remains after all expenses, interest and taxes."
    },
    {
      "term": "Taxable income",
      "anchor": "#definition",
      "definition": "Gross income minus exclusions, exemptions and deductions allowed by tax law."
    }
  ],
  "questions": [
    {
      "id": "q1",
      "type": "apply",
      "q": "Revenue is 500,000, COGS 350,000 and operating expenses 90,000. What is operating income?",
      "a": "60,000.",
      "anchor": "#worked-example",
      "origin": "author"
    },
    {
      "id": "q2",
      "type": "explain",
      "q": "Why does gross income mean different things for a person and a company?",
      "a": "For a person it is income before deductions, for a company it is gross profit.",
      "anchor": "#definition",
      "origin": "author"
    }
  ],
