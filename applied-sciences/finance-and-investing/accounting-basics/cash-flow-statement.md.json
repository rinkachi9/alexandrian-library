    {
      "term": "Operating cash flow",
      "anchor": "#definition",
      "definition": "Cash from the principal revenue-producing activities."
    },
    {
      "term": "Indirect method",
      "anchor": "#mechanism-the-indirect-method",
      "definition": "Starting from net income and adjusting for non-cash items and working capital."
    },
    {
      "term": "Net cash flow",
      "anchor": "#definition",
      "definition": "Operating plus investing plus financing cash flow."
    }
