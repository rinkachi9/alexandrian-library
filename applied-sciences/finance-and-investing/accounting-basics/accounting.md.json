  "concepts": [
    {
      "term": "Accrual accounting",
      "anchor": "#mechanism",
      "definition": "Recording revenue when earned and expenses when incurred, regardless of cash movement."
    },
    {
      "term": "Double-entry bookkeeping",
      "anchor": "#mechanism",
      "definition": "Recording every transaction in two accounts so that debits equal credits."
    },
    {
      "term": "IFRS and US GAAP",
      "anchor": "#mechanism",
      "definition": "The two main accounting frameworks, issued by the IASB and the FASB."
    }
  ],
  "questions": [
    {
      "id": "q1",
      "type": "explain",
      "q": "Why can a profitable company have little cash?",
      "a": "Profit is measured on an accrual basis, while cash is tied up in receivables, inventory and investment.",
      "anchor": "#worked-example",
      "origin": "author"
    },
    {
      "id": "q2",
      "type": "compare",
      "q": "How do financial and managerial accounting differ?",
      "a": "Financial accounting reports to outsiders under standard rules, managerial accounting supports internal decisions.",
      "anchor": "#branches",
      "origin": "author"
    }
