  "concepts": [
    {
      "term": "Quick ratio",
      "anchor": "#the-main-ratios",
      "definition": "Current assets minus inventory and prepaid expenses, divided by current liabilities."
    },
    {
      "term": "Return on equity",
      "anchor": "#the-main-ratios",
      "definition": "Net income divided by average shareholders' equity."
    },
    {
      "term": "DuPont split",
      "anchor": "#the-main-ratios",
      "definition": "ROE as net margin times asset turnover times equity multiplier."
    }
  ],
  "questions": [
    {
      "id": "q1",
      "type": "apply",
      "q": "Net margin 5%, asset turnover 2, equity multiplier 2. What is ROE?",
      "a": "20%.",
      "anchor": "#the-main-ratios",
      "origin": "author"
    },
    {
      "id": "q2",
      "type": "explain",
      "q": "Why can a high ROE be a warning sign?",
      "a": "It may come from high leverage, which raises risk, rather than better operations.",
      "anchor": "#the-main-ratios",
      "origin": "author"
    }
