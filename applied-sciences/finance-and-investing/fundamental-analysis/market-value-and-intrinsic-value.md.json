  "concepts": [
    {
      "term": "Market value",
      "anchor": "#definition",
      "definition": "The price at which an asset would trade in an open market between willing parties."
    },
    {
      "term": "Book value",
      "anchor": "#definition",
      "definition": "Assets minus liabilities as recorded in the accounts."
    },
    {
      "term": "Intrinsic value",
      "anchor": "#definition",
      "definition": "The value implied by fundamentals, the present value of expected cash flows."
    },
    {
      "term": "Fair value",
      "anchor": "#definition",
      "definition": "The accounting measure defined in IFRS 13 as an exit price in an orderly transaction."
    }
  ],
