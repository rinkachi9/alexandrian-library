  "concepts": [
    {
      "term": "Price-to-earnings ratio",
      "anchor": "#definition",
      "definition": "Share price divided by earnings per share."
    },
    {
      "term": "CAPE",
      "anchor": "#definition",
      "definition": "Price divided by ten-year average inflation-adjusted earnings."
    },
    {
      "term": "Earnings yield",
      "anchor": "#definition",
      "definition": "EPS divided by price, the inverse of P/E."
    }
  ],
  "questions": [
