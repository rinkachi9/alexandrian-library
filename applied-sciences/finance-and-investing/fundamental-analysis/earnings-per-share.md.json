  "concepts": [
    {
      "term": "Basic EPS",
      "anchor": "#definition",
      "definition": "Net income minus preferred dividends, divided by the weighted average common shares outstanding."
    },
    {
      "term": "Diluted EPS",
      "anchor": "#definition",
      "definition": "EPS that also counts shares that could be created by options, warrants and convertibles."
    },
    {
      "term": "Weighted average shares",
      "anchor": "#definition",
      "definition": "The share count weighted by the time each share was outstanding."
    }
  ],
  "questions": [
    {
      "id": "q1",
      "type": "explain",
      "q": "Why can EPS rise while net income is flat?",
      "a": "A buyback reduces the share count.",
      "anchor": "#mechanism",
      "origin": "author"
    },
    {
      "id": "q2",
      "type": "apply",
      "q": "Net income 6 million, preferred dividends 0.5 million, 2.2 million weighted shares. What is basic EPS?",
      "a": "2.50.",
      "anchor": "#definition",
      "origin": "author"
    }
  ],
