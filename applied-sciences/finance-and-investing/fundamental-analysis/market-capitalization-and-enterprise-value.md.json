  "concepts": [
    {
      "term": "Market capitalization",
      "anchor": "#definition",
      "definition": "Share price multiplied by shares outstanding."
    },
    {
      "term": "Enterprise value",
      "anchor": "#definition",
      "definition": "Market cap plus debt, preferred shares and minorities, minus cash."
    },
    {
      "term": "Free float",
      "anchor": "#definition",
      "definition": "The shares available to the public, excluding those held by insiders and strategic holders."
    }
  ],
  "questions": [
    {
      "id": "q1",
      "type": "apply",
      "q": "5 million shares at 24, debt 30 million, cash 10 million. What is the EV?",
      "a": "140 million.",
      "anchor": "#worked-example",
      "origin": "author"
    },
    {
      "id": "q2",
      "type": "explain",
      "q": "Why is EV and not market cap used with EBITDA?",
      "a": "EBITDA is earned for all providers of capital, so it must be compared with the value claimed by all of them.",
      "anchor": "#mechanism-and-use",
      "origin": "author"
    }
