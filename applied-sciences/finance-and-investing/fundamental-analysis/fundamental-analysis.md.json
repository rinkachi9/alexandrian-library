  "concepts": [
    {
      "term": "Fundamental analysis",
      "anchor": "#definition",
      "definition": "The study of economic factors that determine the value of a security, compared with its price."
    },
    {
      "term": "Margin of safety",
      "anchor": "#mechanism",
      "definition": "The gap between intrinsic value and price that absorbs errors in the estimate."
    },
    {
      "term": "Top-down and bottom-up",
      "anchor": "#mechanism",
      "definition": "Starting from the economy and industry, or from the company."
    }
  ],
