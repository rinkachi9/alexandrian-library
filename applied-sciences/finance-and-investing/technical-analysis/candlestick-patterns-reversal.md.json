  "concepts": [
    {
      "term": "Hammer",
      "anchor": "#single-candle-patterns",
      "definition": "A small body at the top with a lower shadow at least twice the body, after a fall."
    },
    {
      "term": "Engulfing pattern",
      "anchor": "#two-candle-patterns",
      "definition": "A candle whose body covers the whole body of the previous candle of the opposite color."
    },
    {
      "term": "Doji",
      "anchor": "#single-candle-patterns",
      "definition": "A candle whose open and close are almost equal, showing indecision."
    }
