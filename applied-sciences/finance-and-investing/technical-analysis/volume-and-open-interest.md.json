    {
      "term": "Open interest",
      "anchor": "#definition",
      "definition": "The number of outstanding futures or options contracts not yet closed."
    },
    {
      "term": "On-balance volume",
      "anchor": "#definition",
      "definition": "A running total that adds volume on up days and subtracts it on down days."
