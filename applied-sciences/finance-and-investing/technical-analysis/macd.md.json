  "concepts": [
    {
      "term": "MACD line",
      "anchor": "#definition",
      "definition": "The 12-period EMA of the close minus the 26-period EMA."
    },
    {
      "term": "Signal line",
      "anchor": "#definition",
      "definition": "A 9-period EMA of the MACD line."
    },
    {
      "term": "Histogram",
      "anchor": "#definition",
      "definition": "The MACD line minus the signal line."
    }
