  "concepts": [
    {
      "term": "Support",
      "anchor": "#definition",
      "definition": "A price area below the market where demand has halted declines."
    },
    {
      "term": "Resistance",
      "anchor": "#definition",
      "definition": "A price area above the market where supply has halted rises."
    },
    {
      "term": "Role reversal",
      "anchor": "#definition",
      "definition": "After a breakout, a broken resistance acts as support and the reverse."
    }
  ],
  "questions": [
    {
      "id": "q1",
      "type": "explain",
      "q": "Why are round numbers often levels?",
      "a": "Many traders place orders and stops there, which concentrates supply and demand.",
      "anchor": "#where-levels-come-from",
      "origin": "author"
    },
    {
      "id": "q2",
      "type": "apply",
      "q": "A trader buys at 105 after a breakout, the stop is at 103 and the next resistance is 115. What is the reward-to-risk ratio?",
      "a": "5 to 1.",
      "anchor": "#worked-example",
      "origin": "author"
    }
