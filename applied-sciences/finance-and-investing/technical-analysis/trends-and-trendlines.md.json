    {
      "term": "Uptrend",
      "anchor": "#definition",
      "definition": "A series of higher highs and higher lows."
    },
    {
      "term": "Trendline",
      "anchor": "#definition",
      "definition": "A line joining at least two lows in an uptrend or two highs in a downtrend."
