  "concepts": [
    {
      "term": "Bollinger Bands",
      "anchor": "#definition",
      "definition": "A 20-period average with bands two standard deviations above and below."
    },
    {
      "term": "Percent b",
      "anchor": "#definition",
      "definition": "The position of the close within the bands, 0 at the lower band and 1 at the upper."
    },
    {
      "term": "Squeeze",
      "anchor": "#reading-the-bands",
      "definition": "A period of very narrow bands, usually followed by a larger move."
    }
  ],
  "questions": [
    {
      "id": "q1",
      "type": "apply",
      "q": "The middle band is 50, the standard deviation 3 and k = 2. What are the bands?",
      "a": "Upper 56 and lower 44.",
