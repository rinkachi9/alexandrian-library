  "concepts": [
    {
      "term": "Relative strength index",
      "anchor": "#definition",
      "definition": "An oscillator from 0 to 100 that compares recent gains with recent losses."
    },
    {
      "term": "Bearish divergence",
      "anchor": "#reading-the-rsi",
      "definition": "Price makes a new high while the RSI makes a lower high."
    },
    {
      "term": "Overbought",
      "anchor": "#reading-the-rsi",
      "definition": "A reading above 70 by Wilder's convention."
    }
  ],
  "questions": [
    {
      "id": "q1",
      "type": "apply",
      "q": "Average gain 0.6 and average loss 0.3. What is the RSI?",
      "a": "66.7.",
