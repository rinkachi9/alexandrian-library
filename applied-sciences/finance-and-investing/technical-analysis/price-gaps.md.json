  "concepts": [
    {
      "term": "Gap",
      "anchor": "#definition",
      "definition": "An empty space on the chart between one period's range and the next."
    },
    {
      "term": "Exhaustion gap",
      "anchor": "#types",
      "definition": "A gap near the end of a trend on very high volume, usually filled within days."
    },
    {
      "term": "Island reversal",
      "anchor": "#types",
      "definition": "An exhaustion gap followed by a breakaway gap in the opposite direction."
    }
  ],
  "questions": [
    {
      "id": "q1",
      "type": "recall",
      "q": "Which gap type appears at the start of a trend?",
      "a": "The breakaway gap.",
      "anchor": "#types",
      "origin": "author"
    },
    {
      "id": "q2",
      "type": "explain",
      "q": "Why is the idea that all gaps are filled a myth?",
      "a": "Breakaway and runaway gaps often stay open for months.",
      "anchor": "#trade-offs-and-when-to-use-it",
      "origin": "author"
    }
