  "concepts": [
    {
      "term": "Efficient market hypothesis",
      "anchor": "#definition",
      "definition": "Prices reflect available information, so it is hard to earn excess risk-adjusted returns from that information."
    },
    {
      "term": "Joint hypothesis problem",
      "anchor": "#mechanism",
      "definition": "A test of efficiency is also a test of the asset pricing model used to define excess returns."
