  "concepts": [
    {
      "term": "Short sale",
      "anchor": "#definition",
      "definition": "Selling borrowed securities in the hope of buying them back cheaper."
    },
    {
      "term": "Short squeeze",
      "anchor": "#mechanism",
      "definition": "A rising price forces shorts to buy back, pushing the price up further."
    },
    {
      "term": "Margin call",
      "anchor": "#mechanism",
      "definition": "A demand to add collateral when a position moves against the account."
    }
  ],
  "questions": [
    {
      "id": "q1",
      "type": "explain",
      "q": "Why is the loss on a short sale unlimited?",
      "a": "The price can rise without a limit and the seller must buy back at the higher price.",
      "anchor": "#worked-example",
      "origin": "author"
    },
    {
      "id": "q2",
      "type": "apply",
      "q": "What costs does a short seller pay besides trading fees?",
      "a": "Borrow fee, margin interest and any dividends paid on the borrowed shares.",
      "anchor": "#mechanism",
      "origin": "author"
    }
