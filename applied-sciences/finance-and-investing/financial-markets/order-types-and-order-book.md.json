  "concepts": [
    {
      "term": "Spread",
      "anchor": "#definition",
      "definition": "The ask price minus the bid price, the cost of trading immediately."
    },
    {
      "term": "Limit order",
      "anchor": "#definition",
      "definition": "An order to buy at a set price or lower, or sell at a set price or higher."
    },
    {
      "term": "Slippage",
      "anchor": "#worked-example",
      "definition": "The difference between the expected price and the average fill price."
    }
  ],
  "questions": [
    {
      "id": "q1",
      "type": "apply",
      "q": "Why does a limit sell below the market not work as a stop-loss?",
      "a": "It fills at once at the market price, because it is already marketable.",
      "anchor": "#mechanism",
      "origin": "author"
    },
    {
      "id": "q2",
      "type": "explain",
      "q": "What does a stop order guarantee?",
      "a": "Only a trigger. After the trigger it becomes a market order, and the fill price is not guaranteed.",
      "anchor": "#mechanism",
      "origin": "author"
    }
