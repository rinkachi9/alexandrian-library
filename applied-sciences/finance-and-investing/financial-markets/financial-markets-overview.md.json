  "concepts": [
    {
      "term": "Primary market",
      "anchor": "#classification",
      "definition": "The market where new securities are issued and the issuer receives the money."
    },
    {
      "term": "Secondary market",
      "anchor": "#classification",
      "definition": "The market where existing securities are traded between investors."
    },
    {
      "term": "Price discovery",
      "anchor": "#functions",
      "definition": "The process by which buyers and sellers set prices that reflect expectations."
    }
  ],
  "questions": [
    {
      "id": "q1",
      "type": "compare",
      "q": "What is the difference between the money market and the capital market?",
      "a": "The money market trades debt shorter than a year, the capital market trades longer-term debt and equity.",
      "anchor": "#classification",
      "origin": "author"
    },
    {
      "id": "q2",
      "type": "explain",
      "q": "Why does a trade on the exchange give the company no money?",
      "a": "It is a secondary market trade between investors, and only primary issues pay the issuer.",
      "anchor": "#worked-example",
      "origin": "author"
    }
