  "concepts": [
    {
      "term": "Amortization",
      "anchor": "#definition",
      "definition": "Repaying a loan with payments that cover interest and part of the principal so that the balance reaches zero."
    },
    {
      "term": "Adjustable-rate mortgage",
      "anchor": "#mechanism",
      "definition": "A mortgage with a fixed initial period after which the rate resets with an index plus a margin."
    },
    {
      "term": "Reverse mortgage",
      "anchor": "#mechanism",
      "definition": "A loan that pays an older homeowner against home equity and is repaid when they move or die."
    }
  ],
  "questions": [
    {
      "id": "q1",
      "type": "apply",
      "q": "How is the interest part of a mortgage payment computed?",
      "a": "Balance × monthly rate, and the rest of the payment is principal.",
      "anchor": "#mechanism",
      "origin": "author"
    },
    {
      "id": "q2",
      "type": "compare",
      "q": "Why does a 15-year loan cost less in total than a 30-year loan?",
      "a": "The balance falls faster, so interest accrues on smaller balances for less time.",
      "anchor": "#trade-offs-and-when-to-use-it",
      "origin": "author"
    }
