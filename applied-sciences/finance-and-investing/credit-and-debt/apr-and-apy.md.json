  "concepts": [
    {
      "term": "APR",
      "anchor": "#definition",
      "definition": "The yearly cost of credit as a rate, including some fees but not compounding within the year."
    },
    {
      "term": "APY",
      "anchor": "#definition",
      "definition": "The effective yearly rate including compounding: (1 + r/m)^m - 1."
    }
