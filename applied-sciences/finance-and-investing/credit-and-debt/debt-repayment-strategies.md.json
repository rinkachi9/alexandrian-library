  "concepts": [
    {
      "term": "Debt avalanche",
      "anchor": "#definition",
      "definition": "Paying extra money to the debt with the highest interest rate first."
    },
    {
      "term": "Debt snowball",
      "anchor": "#definition",
      "definition": "Paying extra money to the debt with the smallest balance first."
    },
    {
      "term": "Debt consolidation",
      "anchor": "#definition",
      "definition": "Replacing several debts with one loan, helpful only if the new rate and fees are lower."
    }
  ],
  "questions": [
    {
      "id": "q1",
      "type": "explain",
      "q": "Why is the avalanche never worse than the snowball in total interest?",
      "a": "Each unit paid to a higher rate removes more future interest, given the same total payment.",
      "anchor": "#mechanism",
      "origin": "author"
    },
    {
      "id": "q2",
      "type": "apply",
      "q": "Why must freed payments roll to the next debt?",
      "a": "Keeping the total payment constant is what makes the plan work.",
      "anchor": "#mechanism",
      "origin": "author"
    }
  ],
