  "concepts": [
    {
      "term": "Simple interest",
      "anchor": "#mechanism",
      "definition": "Interest computed on the original principal only: principal × rate × time."
    },
    {
      "term": "Compound interest",
      "anchor": "#mechanism",
      "definition": "Interest added to the balance each period so that it earns interest itself."
    },
    {
      "term": "Real interest rate",
      "anchor": "#mechanism",
      "definition": "The nominal rate adjusted for inflation: (1 + nominal) / (1 + inflation) - 1."
    }
  ],
  "questions": [
    {
      "id": "q1",
      "type": "explain",
      "q": "Why does compounding frequency matter less than the rate itself?",
      "a": "Moving from monthly to daily compounding changes the result slightly, while the rate and the time change it a lot.",
      "anchor": "#worked-example",
      "origin": "author"
    },
    {
      "id": "q2",
      "type": "recall",
      "q": "What parts make up a market interest rate?",
      "a": "The real return, expected inflation, a default risk premium and a term and liquidity premium, anchored by the policy rate.",
      "anchor": "#mechanism",
      "origin": "author"
    }
  ],
