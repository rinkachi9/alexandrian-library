  "concepts": [
    {
      "term": "Diversification",
      "anchor": "#definition",
      "definition": "Reducing portfolio risk by holding assets with imperfectly correlated returns."
    },
    {
      "term": "Correlation",
      "anchor": "#definition",
      "definition": "A measure from -1 to +1 of how two returns move together."
    },
    {
      "term": "Specific risk",
      "anchor": "#mechanism",
      "definition": "Risk that belongs to one company and can be removed by diversifying."
    }
  ],
  "questions": [
    {
      "id": "q1",
      "type": "apply",
      "q": "Two assets each have risk 15%. What is the risk of a 50/50 portfolio at correlation +1?",
      "a": "15%, with no benefit.",
      "anchor": "#worked-example",
      "origin": "author"
    },
    {
      "id": "q2",
      "type": "explain",
      "q": "Why is holding five funds not always diversification?",
      "a": "If they hold the same kind of assets their returns are highly correlated.",
      "anchor": "#not-the-same-as-naive-splitting",
      "origin": "author"
    }
