  "concepts": [
    {
      "term": "Standard deviation",
      "anchor": "#definition",
      "definition": "The usual measure of risk: how far returns typically fall from their average."
    },
    {
      "term": "Geometric mean return",
      "anchor": "#definition",
      "definition": "The constant rate that gives the same final value as the actual sequence of returns."
    },
    {
      "term": "Sharpe ratio",
      "anchor": "#definition",
      "definition": "Mean return minus the risk-free rate, divided by the standard deviation."
    },
    {
      "term": "Drawdown",
      "anchor": "#definition",
      "definition": "The fall from a peak to a later low."
    }
  ],
  "questions": [
    {
      "id": "q1",
      "type": "explain",
      "q": "Why is the geometric mean below the arithmetic mean when returns vary?",
      "a": "Volatility drags down compound growth, by roughly half the variance.",
      "anchor": "#mechanism-why-the-geometric-mean-is-lower",
      "origin": "author"
    },
    {
      "id": "q2",
      "type": "recall",
      "q": "What is the equity premium?",
      "a": "The extra return of stocks over the risk-free rate, about 6.6 points in the US data.",
      "anchor": "#mechanism-why-the-geometric-mean-is-lower",
      "origin": "author"
    }
  ],
