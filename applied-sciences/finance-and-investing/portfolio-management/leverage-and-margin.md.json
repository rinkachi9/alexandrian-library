  "concepts": [
    {
      "term": "Leverage",
      "anchor": "#definition",
      "definition": "Position size divided by own capital."
    },
    {
      "term": "Margin call",
      "anchor": "#definition",
      "definition": "A demand to add funds or close positions when equity falls below the maintenance level."
    },
    {
      "term": "Maintenance margin",
      "anchor": "#definition",
      "definition": "The minimum equity that must be kept after a position is opened."
    }
  ],
  "questions": [
    {
      "id": "q1",
      "type": "apply",
      "q": "A position of 50,000 is held with 10,000 of own capital. What fall wipes out the capital?",
      "a": "20%.",
      "anchor": "#worked-example",
      "origin": "author"
    },
    {
      "id": "q2",
      "type": "explain",
      "q": "Why can a margin call turn a temporary loss into a permanent one?",
      "a": "The position is sold at the low price so the investor cannot wait for a recovery.",
      "anchor": "#trade-offs-and-when-to-use-it",
      "origin": "author"
