    {
      "term": "Existence precedes essence",
      "anchor": "#key-concepts",
      "definition": "A person first exists and then defines what they are through choices."
    },
    {
      "term": "Bad faith",
      "anchor": "#key-concepts",
      "definition": "Denying one's freedom, for example by claiming that one had no choice."
