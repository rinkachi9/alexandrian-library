  "concepts": [
    {
      "term": "Liberalism",
      "anchor": "#definition",
      "definition": "A family of political doctrines that treat the individual as the basic unit and freedom as the central value."
    },
    {
      "term": "Harm principle",
      "anchor": "#main-ideas",
      "definition": "Society may restrict a person's liberty against their will only to prevent harm to others."
    },
    {
      "term": "Negative and positive liberty",
      "anchor": "#main-ideas",
      "definition": "Freedom from interference versus the capacity to act on one's own purposes."
    },
    {
      "term": "Social liberalism",
      "anchor": "#classical-and-social-liberalism",
      "definition": "The strand that accepts an active state to secure the conditions of freedom."
    }
  ],
  "questions": [
    {
      "id": "q1",
      "type": "recall",
      "q": "What is the harm principle?",
      "a": "Society may restrict liberty against a person's will only to prevent harm to others.",
      "anchor": "#main-ideas",
      "origin": "author"
    },
    {
      "id": "q2",
      "type": "compare",
      "q": "How do classical and social liberalism differ?",
      "a": "Classical liberals favor a minimal state and negative liberty, social liberals accept an active state and positive liberty.",
      "anchor": "#classical-and-social-liberalism",
      "origin": "author"
    }
  ],
