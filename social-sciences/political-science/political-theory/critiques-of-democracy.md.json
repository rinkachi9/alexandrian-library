      "term": "Epistocracy",
      "anchor": "#main-arguments",
      "definition": "Rule by the knowledgeable, for example by weighting votes by political knowledge."
    },
    {
      "term": "Condorcet jury theorem",
      "anchor": "#the-epistemic-reply",
      "definition": "If voters are independent and each more likely right than wrong, a larger majority is more likely right."
    }
