  "questions": [
    {
      "id": "q1",
      "type": "compare",
      "q": "What is the difference between an instrumental and an intrinsic argument against democracy?",
      "a": "Instrumental arguments say democracy gives worse results than an alternative, intrinsic ones that it lacks a value it claims.",
      "anchor": "#definition",
      "origin": "author"
    },
    {
      "id": "q2",
      "type": "explain",
      "q": "Why does the jury theorem also support the critics?",
      "a": "If voters are more likely wrong than right, a larger group is more likely to be wrong.",
      "anchor": "#worked-example",
      "origin": "author"
    }
