  "concepts": [
    {
      "term": "Democracy",
      "anchor": "#definition",
      "definition": "A regime in which citizens take part in exercising power, directly or through elected representatives."
    },
    {
      "term": "Polyarchy",
      "anchor": "#what-counts-as-democracy",
      "definition": "Dahl's term for a regime high on both public contestation and inclusiveness."
    },
    {
      "term": "Liberal democracy",
      "anchor": "#liberal-democracy",
      "definition": "A democracy with free elections, pluralism and constitutional protection of rights and minorities."
    }
  ],
  "questions": [
    {
      "id": "q1",
      "type": "recall",
      "q": "What are Dahl's two dimensions?",
      "a": "Public contestation and inclusiveness.",
      "anchor": "#what-counts-as-democracy",
      "origin": "author"
    },
    {
      "id": "q2",
      "type": "compare",
      "q": "How does a liberal democracy differ from a minimalist one?",
      "a": "It adds constitutional limits that protect rights and minorities.",
      "anchor": "#what-counts-as-democracy",
      "origin": "author"
    },
    {
      "id": "q3",
      "type": "apply",
      "q": "A country holds elections with universal voting but no real opposition. What type is it in Dahl's scheme?",
      "a": "Inclusive hegemony.",
      "anchor": "#worked-example",
      "origin": "author"
    }
