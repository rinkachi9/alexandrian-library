  "concepts": [
    {
      "term": "Gross domestic product",
      "anchor": "#definition",
      "definition": "The market value of final goods and services produced inside a country in a period."
    },
    {
      "term": "Real GDP",
      "anchor": "#related-measures",
      "definition": "GDP at constant prices, which shows the change in volume."
    },
    {
      "term": "GDP deflator",
      "anchor": "#related-measures",
      "definition": "Nominal GDP divided by real GDP times 100, a measure of the price change."
    }
