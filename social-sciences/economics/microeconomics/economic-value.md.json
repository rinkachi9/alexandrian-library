  "concepts": [
    {
      "term": "Economic value",
      "anchor": "#definition",
      "definition": "The most a person would give up to obtain something, their willingness to pay."
    },
    {
      "term": "Opportunity cost",
      "anchor": "#definition",
      "definition": "The value of the best alternative given up by a choice."
    },
    {
      "term": "Consumer surplus",
      "anchor": "#surplus",
      "definition": "Willingness to pay minus the price paid."
    },
    {
      "term": "Economic value added",
      "anchor": "#kinds-of-value",
      "definition": "Net operating profit after tax minus a charge for the capital used."
    }
  ],
