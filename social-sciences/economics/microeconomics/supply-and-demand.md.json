  "concepts": [
    {
      "term": "Law of demand",
      "anchor": "#definition",
      "definition": "Other things equal, a higher price lowers the quantity demanded."
    },
    {
      "term": "Law of supply",
      "anchor": "#definition",
      "definition": "Other things equal, a higher price raises the quantity supplied."
    },
    {
      "term": "Equilibrium",
      "anchor": "#definition",
      "definition": "The price and quantity at which quantity demanded equals quantity supplied."
    },
    {
      "term": "Price ceiling",
      "anchor": "#price-controls",
      "definition": "A legal maximum price, which below equilibrium causes a shortage."
    }
