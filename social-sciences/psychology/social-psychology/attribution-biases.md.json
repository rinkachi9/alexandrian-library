  "concepts": [
    {
      "term": "Fundamental attribution error",
      "anchor": "#definition",
      "definition": "Overweighting character and underweighting the situation when explaining another person's behavior."
    },
    {
      "term": "Self-serving bias",
      "anchor": "#definition",
      "definition": "Crediting oneself for success and blaming circumstances for failure."
    }
  ],
