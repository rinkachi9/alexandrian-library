    {
      "term": "Liking gap",
      "anchor": "#definition",
      "definition": "People underestimate how much their conversation partners like them."
    },
    {
      "term": "Pratfall effect",
      "anchor": "#definition",
      "definition": "A minor blunder can raise the likability of a person seen as highly competent."
    }
