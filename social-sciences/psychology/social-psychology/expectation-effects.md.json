    {
      "term": "Pygmalion effect",
      "anchor": "#definition",
      "definition": "Better performance after high expectations from an authority."
    },
    {
      "term": "Golem effect",
      "anchor": "#definition",
      "definition": "Worse performance after low expectations."
    },
    {
      "term": "Self-fulfilling prophecy",
      "anchor": "#definition",
      "definition": "A belief that causes behavior which makes the belief come true."
    }
  ],
  "questions": [
    {
      "id": "q1",
      "type": "compare",
      "q": "Distinguish the Pygmalion effect and the Golem effect.",
      "a": "The first is better performance after high expectations, the second worse performance after low ones.",
