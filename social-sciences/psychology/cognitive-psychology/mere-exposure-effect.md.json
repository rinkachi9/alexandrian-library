    {
      "term": "Mere exposure effect",
      "anchor": "#definition",
      "definition": "Repeated exposure to a stimulus increases liking for it."
    },
    {
      "term": "Fluency",
      "anchor": "#mechanism",
      "definition": "The ease of processing a familiar stimulus, which is felt as positive."
    }
