  "concepts": [
    {
      "term": "Loss aversion",
      "anchor": "#definition",
      "definition": "The asymmetry by which losses weigh more than gains of the same size."
    },
    {
      "term": "Reference point",
      "anchor": "#definition",
      "definition": "The level from which gains and losses are measured."
    }
  ],
  "questions": [
    {
      "id": "q1",
      "type": "explain",
      "q": "Why is a fair coin flip unattractive under prospect theory?",
      "a": "The loss side of the value function is steeper, so the negative value of the loss outweighs the gain.",
      "anchor": "#worked-example",
      "origin": "author"
    },
    {
      "id": "q2",
      "type": "recall",
      "q": "What does the coefficient 2.25 say?",
      "a": "Losses weigh about 2.25 times as much as equal gains in the estimates of Tversky and Kahneman (1992).",
      "anchor": "#definition",
      "origin": "author"
    }
