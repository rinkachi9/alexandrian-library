  "concepts": [
    {
      "term": "Heuristic",
      "anchor": "#definition",
      "definition": "A fast mental shortcut that replaces a hard question with an easier one."
    },
    {
      "term": "Cognitive bias",
      "anchor": "#definition",
      "definition": "A systematic deviation from a normative standard in judgment or choice."
    },
    {
      "term": "Anchoring",
      "anchor": "#definition",
      "definition": "Starting from a number and adjusting too little."
    }
