  "concepts": [
    {
      "term": "Internal object",
      "anchor": "#definition",
      "definition": "The mental representation of a significant person together with the feelings tied to the relationship."
    },
    {
      "term": "Splitting",
      "anchor": "#core-ideas",
      "definition": "Experiencing a person as all good or all bad because good and bad experiences are kept apart."
    },
    {
      "term": "Object constancy",
      "anchor": "#core-ideas",
      "definition": "The ability to keep a stable emotional bond during frustration, absence or conflict."
    },
    {
      "term": "Paranoid-schizoid and depressive positions",
      "anchor": "#core-ideas",
      "definition": "Klein's two modes of experience, split and integrated, that a person moves between."
    }
  ],
  "questions": [
    {
      "id": "q1",
      "type": "recall",
      "q": "What does object mean in object relations theory?",
      "a": "A person who is emotionally significant to the individual.",
      "anchor": "#definition",
      "origin": "author"
    },
    {
      "id": "q2",
      "type": "explain",
      "q": "What is splitting?",
      "a": "Experiencing a person as all good or all bad because the good and bad experiences are kept apart.",
      "anchor": "#core-ideas",
      "origin": "author"
    },
    {
      "id": "q3",
      "type": "compare",
      "q": "How do object relations theory and attachment theory differ in method?",
      "a": "Object relations relies on clinical observation of inner representations, attachment theory on empirical study of attachment behavior.",
      "anchor": "#relation-to-attachment-theory",
      "origin": "author"
    }
