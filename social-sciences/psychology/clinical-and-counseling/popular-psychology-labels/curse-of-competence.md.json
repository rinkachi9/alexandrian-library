  "concepts": [
    {
      "term": "Curse of competence",
      "anchor": "#definition",
      "definition": "The pattern in which being good at a task brings more of it, without matching reward."
    },
    {
      "term": "Curse of knowledge",
      "anchor": "#psychological-and-organizational-aspects",
      "definition": "The difficulty of imagining not knowing something once you know it."
    }
