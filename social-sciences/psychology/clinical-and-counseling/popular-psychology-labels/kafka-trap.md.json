  "concepts": [
    {
      "term": "Kafka trap",
      "anchor": "#definition",
      "definition": "An accusation built so that every reply, including denial, confirms it."
    },
    {
      "term": "Unfalsifiable claim",
      "anchor": "#definition",
      "definition": "A claim that no possible observation could count against."
    }
  ],
  "questions": [
    {
      "id": "q1",
      "type": "explain",
      "q": "Why is a likelihood ratio of 1 a sign of a Kafka trap?",
      "a": "The reply is equally likely whether the accusation is true or false, so it carries no information.",
      "anchor": "#worked-example",
      "origin": "author"
    },
    {
      "id": "q2",
      "type": "recall",
      "q": "Who coined the term, and in which year?",
      "a": "Eric S. Raymond, in 2010.",
