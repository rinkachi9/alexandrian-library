  "concepts": [
    {
      "term": "Antifragile",
      "anchor": "#definition",
      "definition": "Gaining from volatility and stress, as opposed to being harmed or unaffected."
    },
    {
      "term": "Hormesis",
      "anchor": "#origin",
      "definition": "A dose response in which a small dose stimulates and a large dose harms."
    },
    {
      "term": "Fragile self-esteem",
      "anchor": "#psychological-aspects",
      "definition": "High self-esteem that depends on approval and is defended against threats."
    }
  ],
  "questions": [
    {
      "id": "q1",
      "type": "compare",
      "q": "What is the difference between robust and antifragile?",
      "a": "Robust means unharmed by stress, and antifragile means improved by it.",
      "anchor": "#definition",
      "origin": "author"
    },
    {
      "id": "q2",
      "type": "explain",
      "q": "Why is posttraumatic growth research criticized?",
      "a": "Much of the growth is perceived and self-reported, and few studies show real change over time.",
      "anchor": "#psychological-aspects",
      "origin": "author"
    }
  ],
