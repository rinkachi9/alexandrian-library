  "concepts": [
    {
      "term": "Neuro-linguistic programming",
      "anchor": "#definition",
      "definition": "A collection of communication and self-change techniques and beliefs promoted by Bandler and Grinder from the 1970s."
    },
    {
      "term": "Anchoring",
      "anchor": "#main-techniques",
      "definition": "Linking an emotional state to a touch, image or sound, which resembles classical conditioning."
    },
    {
      "term": "Preferred representational system",
      "anchor": "#evidence",
      "definition": "The NLP claim that people think mainly in one sense, which tests did not support."
    }
  ],
  "questions": [
    {
      "id": "q1",
      "type": "explain",
      "q": "Which parts of NLP are best described as renamed established methods?",
      "a": "Anchoring (classical conditioning) and reframing (cognitive reappraisal).",
      "anchor": "#main-techniques",
      "origin": "author"
    },
    {
      "id": "q2",
      "type": "recall",
      "q": "What did Sturt and colleagues (2012) conclude?",
      "a": "There is little evidence that NLP improves health outcomes, because the research is small and weak, which is not proof of no effect.",
      "anchor": "#evidence",
      "origin": "author"
    }
