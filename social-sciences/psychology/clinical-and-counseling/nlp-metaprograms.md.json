  "concepts": [
    {
      "term": "Metaprogram",
      "anchor": "#definition",
      "definition": "In NLP, a habitual filter that guides what a person attends to and how they decide, in a given context."
    },
    {
      "term": "Regulatory fit",
      "anchor": "#evidence",
      "definition": "The finding that messages framed to fit a person's promotion or prevention focus persuade better."
    }
  ],
  "questions": [
    {
      "id": "q1",
      "type": "recall",
      "q": "Which researched construct is closest to toward and away from motivation?",
      "a": "Promotion and prevention focus (regulatory focus theory).",
      "anchor": "#the-common-dimensions",
      "origin": "author"
    },
    {
      "id": "q2",
      "type": "explain",
      "q": "Why is it better to ask a person what matters to them than to infer their metaprogram?",
      "a": "Inference from words is unreliable and the typology is unvalidated, while a question gives the information at once.",
      "anchor": "#worked-example",
      "origin": "author"
    }
  ],
