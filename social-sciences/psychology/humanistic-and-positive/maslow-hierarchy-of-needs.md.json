  "concepts": [
    {
      "term": "Hierarchy of needs",
      "anchor": "#definition",
      "definition": "Maslow's grouping of human needs into five levels ordered by urgency."
    },
    {
      "term": "Prepotency",
      "anchor": "#how-the-hierarchy-is-meant-to-work",
      "definition": "The most urgent unmet need dominates behavior until it is reasonably satisfied."
    },
    {
      "term": "Self-actualization",
      "anchor": "#the-five-levels",
      "definition": "The need to realize one's potential, at the top of the five levels."
    }
  ],
  "questions": [
    {
      "id": "q1",
      "type": "recall",
      "q": "What are the five levels?",
      "a": "Physiological, safety, love and belonging, esteem and self-actualization.",
      "anchor": "#the-five-levels",
      "origin": "author"
    },
    {
      "id": "q2",
      "type": "explain",
      "q": "Who drew the pyramid?",
      "a": "Later authors in management literature, not Maslow's 1943 paper.",
      "anchor": "#the-five-levels",
      "origin": "author"
    },
    {
      "id": "q3",
      "type": "apply",
      "q": "A worker loses a job when rent is due. Which need dominates, and why do others remain active?",
      "a": "Safety dominates, but belonging and esteem are still active, so needs do not wait their turn.",
      "anchor": "#evidence",
      "origin": "author"
    }
  ],
