      "id": "q1",
      "type": "apply",
      "q": "A skill has importance 3, required level 3 and current level 0. What is its priority?",
      "a": "The gap is 3, so priority = 3 x 3 = 9.",
      "anchor": "#gap-analysis",
      "origin": "author"
    },
