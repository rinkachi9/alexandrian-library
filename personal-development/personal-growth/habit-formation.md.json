  "concepts": [
    {
      "term": "Habit",
      "anchor": "#definition",
      "definition": "A learned association between a context cue and a response, carried out with little thought."
    },
    {
      "term": "Implementation intention",
      "anchor": "#implementation-intentions",
      "definition": "A plan of the form: if situation X occurs, I will do Y."
    },
    {
      "term": "Automaticity",
      "anchor": "#definition",
      "definition": "The degree to which a behavior needs no deliberate intention."
    }
