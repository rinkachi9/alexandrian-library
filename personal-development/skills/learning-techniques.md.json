  "concepts": [
    {
      "term": "Desirable difficulties",
      "anchor": "#desirable-difficulties",
      "definition": "Conditions that slow apparent progress but improve long-term retention and transfer."
    },
    {
      "term": "Retrieval practice",
      "anchor": "#retrieval-practice",
      "definition": "Bringing information or a procedure back from memory instead of re-reading it."
    },
    {
      "term": "Interleaving",
      "anchor": "#interleaving",
      "definition": "Mixing different problem types in one practice session."
    },
    {
      "term": "Expertise reversal effect",
      "anchor": "#worked-examples-and-the-expertise-reversal-effect",
      "definition": "Worked examples help beginners but stop helping, or hurt, learners who already have expertise."
    }
  ],
  "questions": [
    {
      "id": "q1",
      "type": "explain",
      "q": "Why do learners prefer rereading even though it is less effective?",
      "a": "It feels fluent and easy, and learners judge learning by how easy study feels.",
      "anchor": "#desirable-difficulties",
      "origin": "ai",
      "reviewed": false
    },
    {
      "id": "q2",
      "type": "recall",
      "q": "How should the gap between study sessions change with the desired retention period?",
      "a": "It should grow: for retention over months, gaps of days to weeks work better than hours.",
      "anchor": "#distributed-practice",
      "origin": "ai",
      "reviewed": false
    },
    {
      "id": "q3",
      "type": "apply",
      "q": "How would you apply interleaving when learning to audit web pages?",
      "a": "Audit different page types, such as product, category and blog pages, in one session instead of one type per week.",
      "anchor": "#interleaving",
      "origin": "ai",
      "reviewed": false
    }
  ],
