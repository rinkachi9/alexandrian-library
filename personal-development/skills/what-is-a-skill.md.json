  "concepts": [
    {
      "term": "Skill",
      "anchor": "#definition",
      "definition": "A learned ability to perform a task to a standard, reliably and repeatedly."
    },
    {
      "term": "Competence",
      "anchor": "#knowledge-skills-abilities-and-competences",
      "definition": "The proven use of knowledge, skills and personal abilities in a real context, with responsibility and autonomy."
    },
    {
      "term": "Tacit knowledge",
      "anchor": "#declarative-and-procedural-knowledge",
      "definition": "Knowledge that shows in performance but is hard to put into words."
    },
    {
      "term": "Far transfer",
      "anchor": "#transfer",
      "definition": "Use of a skill learned in one context in a very different one, which research finds to be rare."
    }
  ],
  "questions": [
    {
      "id": "q1",
      "type": "compare",
      "q": "How does an ability differ from a skill?",
      "a": "An ability is a relatively stable capacity such as working memory; a skill is learned for a specific task and improves with practice.",
      "anchor": "#knowledge-skills-abilities-and-competences",
      "origin": "ai",
      "reviewed": false
    },
    {
      "id": "q2",
      "type": "recall",
      "q": "Where does the term soft skills come from?",
      "a": "From US Army training research, including a 1972 CONARC conference that defined soft skills as job skills with little interaction with machines.",
      "anchor": "#hard-and-soft-skills",
      "origin": "ai",
      "reviewed": false
    },
    {
      "id": "q3",
      "type": "explain",
      "q": "Why do tool-specific skills lose value faster than foundational ones?",
      "a": "Tools and their procedures change with technology, while foundations such as writing or reasoning apply across tools; Deming and Noray found fast skill change in technology-intensive jobs.",
      "anchor": "#how-skills-change-in-value",
      "origin": "ai",
      "reviewed": false
    }
  ],
