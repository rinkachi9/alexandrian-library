  "concepts": [
    {
      "term": "Performance versus learning",
      "anchor": "#definition",
      "definition": "Performance is how well you do during practice; learning is the lasting change that shows later."
    },
    {
      "term": "Proceduralization",
      "anchor": "#proceduralization-in-act-theory",
      "definition": "The conversion of declarative instructions into condition-action rules applied directly."
    },
    {
      "term": "Arrested development",
      "anchor": "#arrested-development",
      "definition": "The halt of improvement when a skill becomes automatic and is no longer practiced with attention."
    },
    {
      "term": "Knowledge of performance",
      "anchor": "#feedback",
      "definition": "Feedback about the process of an action rather than its outcome."
    }
  ],
  "questions": [
    {
      "id": "q1",
      "type": "explain",
      "q": "Why does improvement slow down with practice?",
      "a": "Early practice removes large, easy errors; later gains need harder, more specific practice, so learning curves flatten.",
      "anchor": "#the-learning-curve",
      "origin": "ai",
      "reviewed": false
    },
    {
      "id": "q2",
      "type": "apply",
      "q": "A learner follows a checklist perfectly after two weeks. What should change next?",
      "a": "Practice without the checklist and use it only to review, moving from the cognitive to the associative stage.",
      "anchor": "#the-three-stages-of-fitts-and-posner",
      "origin": "ai",
      "reviewed": false
    },
    {
      "id": "q3",
      "type": "recall",
      "q": "What are the five stages of the Dreyfus model?",
      "a": "Novice, advanced beginner, competent, proficient, expert.",
      "anchor": "#the-dreyfus-model",
      "origin": "ai",
      "reviewed": false
    }
  ],
