  "concepts": [
    {
      "term": "Eisenhower matrix",
      "anchor": "#definition",
      "definition": "A matrix of importance and urgency used to decide what to do, schedule, delegate or drop."
    },
    {
      "term": "Mere urgency effect",
      "anchor": "#the-mere-urgency-effect",
      "definition": "The tendency to prefer tasks with short deadlines even when they are worth less."
    }
