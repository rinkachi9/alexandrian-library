  "questions": [
    {
      "id": "q1",
      "type": "recall",
      "q": "What are the four categories of the action priority matrix?",
      "a": "Quick wins, major projects, fill-ins and thankless tasks.",
      "anchor": "#the-matrices",
      "origin": "author"
    },
    {
      "id": "q2",
      "type": "explain",
      "q": "What does the mere urgency effect show?",
      "a": "People pick tasks with short deadlines over tasks with a larger payoff and a longer deadline.",
      "anchor": "#the-mere-urgency-effect",
      "origin": "author"
