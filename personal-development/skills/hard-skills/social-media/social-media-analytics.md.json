  "questions": [
    {
      "id": "q1",
      "type": "explain",
      "q": "Why must you state the engagement rate formula?",
      "a": "Different bases (reach, impressions, followers) give very different numbers, so comparisons are only valid with the same formula.",
      "anchor": "#engagement-rate-formulas",
      "origin": "ai",
      "reviewed": false
    },
    {
      "id": "q2",
      "type": "explain",
      "q": "Why does last-click attribution undervalue social media?",
      "a": "Social often influences purchases that later happen through search or direct visits.",
      "anchor": "#platform-analytics-and-web-analytics",
      "origin": "ai",
      "reviewed": false
    },
    {
      "id": "q3",
      "type": "recall",
      "q": "What does the US FTC rule say about fake social media indicators?",
      "a": "Buying or selling fake indicators of social media influence, such as fake followers, is prohibited.",
      "anchor": "#pitfalls",
      "origin": "ai",
      "reviewed": false
