  "concepts": [
    {
      "term": "Influencer",
      "anchor": "#definition",
      "definition": "A person with an audience on one or more platforms who can affect its opinions or purchases."
    },
    {
      "term": "Material connection",
      "anchor": "#disclosure-the-law",
      "definition": "A relationship between endorser and brand, such as payment or free products, that must be disclosed."
    },
    {
      "term": "Parasocial relationship",
      "anchor": "#why-it-works",
      "definition": "A one-sided sense of familiarity viewers develop with media figures."
    }
  ],
