  "concepts": [
    {
      "term": "Campaign objective",
      "anchor": "#objectives-and-optimization",
      "definition": "The result the platform optimizes delivery for, such as purchases or clicks."
    },
    {
      "term": "Lookalike audience",
      "anchor": "#audiences",
      "definition": "People similar to an advertiser's existing customers."
    },
    {
      "term": "Conversions API",
      "anchor": "#measurement-and-tracking",
      "definition": "Server-side sending of conversion events from a shop to an ad platform."
    },
    {
      "term": "App Tracking Transparency",
      "anchor": "#measurement-and-tracking",
      "definition": "Apple's 2021 requirement that apps ask permission to track users across other companies' apps and sites."
    }
  ],
  "questions": [
    {
      "id": "q1",
      "type": "explain",
      "q": "Why does choosing a traffic objective usually produce poor sales?",
      "a": "The system finds people likely to click, not people likely to buy.",
      "anchor": "#objectives-and-optimization",
      "origin": "ai",
      "reviewed": false
    },
    {
      "id": "q2",
      "type": "explain",
      "q": "Why is creative often the most important lever in paid social?",
      "a": "The algorithm finds audiences itself but cannot improve a weak ad.",
      "anchor": "#creative",
      "origin": "ai",
      "reviewed": false
    },
    {
      "id": "q3",
      "type": "apply",
      "q": "A 350 budget test produces 13 purchases with a total ROAS of 1.49 against break-even 1.70. What next?",
      "a": "Do not conclude yet: keep the creatives above break-even, add variations, run another week and check sales against own data.",
      "anchor": "#worked-example",
      "origin": "ai",
      "reviewed": false
    }
  ],
