  "concepts": [
    {
      "term": "Personal brand",
      "anchor": "#definition",
      "definition": "The set of associations a target audience holds about a person in a professional context."
    },
    {
      "term": "Impression management",
      "anchor": "#impression-management-research",
      "definition": "The process of influencing the impressions others form of oneself."
    },
    {
      "term": "Self-promotion",
      "anchor": "#impression-management-research",
      "definition": "An impression management strategy aimed at being seen as competent, which can reduce likeability."
    }
