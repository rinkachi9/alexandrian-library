  "concepts": [
    {
      "term": "Reputation",
      "anchor": "#definition",
      "definition": "The collective judgment others hold about a person or organization."
    },
    {
      "term": "Right to be forgotten",
      "anchor": "#legal-tools",
      "definition": "The right, from GDPR Article 17 and the Google Spain judgment, to have certain links about oneself removed from search results."
    },
    {
      "term": "Streisand effect",
      "anchor": "#legal-tools",
      "definition": "Attention drawn to content by attempts to suppress it."
    }
  ],
  "questions": [
    {
      "id": "q1",
      "type": "recall",
      "q": "What did the CJEU decide in Google Spain (C-131/12)?",
      "a": "Search engines can be required to delist links to inadequate, irrelevant or no longer relevant information about a person, balancing public interest.",
      "anchor": "#legal-tools",
      "origin": "ai",
      "reviewed": false
    },
    {
      "id": "q2",
      "type": "explain",
      "q": "Why is asking only happy clients for reviews a problem?",
      "a": "It distorts the picture; asking all clients makes ratings fairer and more credible.",
      "anchor": "#building-positive-accurate-presence",
      "origin": "ai",
      "reviewed": false
    },
    {
      "id": "q3",
      "type": "apply",
      "q": "Name the five steps for responding to legitimate criticism.",
      "a": "Pause, check facts, respond briefly and politely, fix the problem, learn.",
      "anchor": "#responding-to-criticism",
      "origin": "ai",
      "reviewed": false
    }
