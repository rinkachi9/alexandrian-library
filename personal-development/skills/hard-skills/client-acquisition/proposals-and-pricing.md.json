  "concepts": [
    {
      "term": "Value-based pricing",
      "anchor": "#pricing-approaches",
      "definition": "Setting a price as a share of the economic value the client gets."
    },
    {
      "term": "Scope creep",
      "anchor": "#definitions",
      "definition": "Gradual expansion of work beyond the agreed scope without matching changes in price or time."
    },
    {
      "term": "BATNA",
      "anchor": "#negotiation",
      "definition": "Best alternative to a negotiated agreement, your walk-away reference."
    }
  ],
  "questions": [
    {
      "id": "q1",
      "type": "explain",
      "q": "Why should the proposal never be the first time a client hears the price?",
      "a": "Price surprises cause rejection; a range discussed in the call lets the proposal confirm expectations.",
      "anchor": "#common-mistakes",
      "origin": "ai",
      "reviewed": false
    },
    {
      "id": "q2",
      "type": "apply",
      "q": "A client asks for a lower price. What do you do?",
      "a": "Trade rather than cave: reduce scope, change timing or terms, and discuss value.",
      "anchor": "#negotiation",
      "origin": "ai",
      "reviewed": false
    },
    {
      "id": "q3",
      "type": "recall",
      "q": "What default B2B payment period does the EU Late Payment Directive set?",
      "a": "30 days unless otherwise agreed, generally capped at 60 days.",
      "anchor": "#payment-terms",
      "origin": "ai",
      "reviewed": false
    }
  ],
