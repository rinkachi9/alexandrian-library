  "concepts": [
    {
      "term": "Churn",
      "anchor": "#definitions",
      "definition": "The share of clients lost in a period."
    },
    {
      "term": "Revenue retention",
      "anchor": "#measuring-retention",
      "definition": "Revenue from existing clients at the end of a period divided by their revenue at the start."
    },
    {
      "term": "Net Promoter Score",
      "anchor": "#evidence-and-its-limits",
      "definition": "Share of promoters minus share of detractors on a 0 to 10 recommendation question."
    }
