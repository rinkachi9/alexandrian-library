    {
      "term": "Objection",
      "anchor": "#definitions",
      "definition": "A stated concern or reason not to proceed."
    },
    {
      "term": "Stall",
      "anchor": "#definitions",
      "definition": "A delay without a clear reason that often hides an unstated objection."
    },
    {
      "term": "Advance",
      "anchor": "#definitions",
      "definition": "An action that moves a sale forward, such as agreeing to a pilot."
