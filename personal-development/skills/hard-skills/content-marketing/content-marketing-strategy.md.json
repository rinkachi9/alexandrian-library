    {
      "term": "Content marketing strategy",
      "anchor": "#definition",
      "definition": "The set of decisions that connects content to a business goal: audience, problem, form, channels, cadence and metrics."
    },
    {
      "term": "Vanity metric",
      "anchor": "#metrics-by-stage",
      "definition": "A number that grows without saying anything about the goal."
    }
  ],
  "questions": [
    {
      "id": "q1",
      "type": "apply",
      "q": "A program aims to generate demo requests. Which metric is primary, and which is a vanity metric?",
      "a": "Demo requests attributed to content are primary; total page views are a vanity metric for this goal.",
      "anchor": "#metrics-by-stage",
      "origin": "ai",
      "reviewed": false
    },
    {
      "id": "q2",
      "type": "explain",
      "q": "Why is a strategy described as a hypothesis?",
      "a": "Because it is a bet about what the audience needs and what will work, which must be tested against results and revised.",
      "anchor": "#the-strategy-as-a-hypothesis",
      "origin": "ai",
      "reviewed": false
    }
