  "concepts": [
    {
      "term": "Double opt-in",
      "anchor": "#building-a-list",
      "definition": "Confirmation of a subscription by clicking a link in a confirmation email."
    },
    {
      "term": "Deliverability",
      "anchor": "#deliverability",
      "definition": "The share of emails that reach the inbox rather than spam or nowhere."
    },
    {
      "term": "DMARC",
      "anchor": "#deliverability",
      "definition": "A policy that tells providers what to do when SPF or DKIM checks fail and requires alignment with the From domain."
    },
    {
      "term": "Mail Privacy Protection",
      "anchor": "#metrics",
      "definition": "Apple's 2021 feature that preloads email content and inflates open rates."
    }
  ],
  "questions": [
    {
      "id": "q1",
      "type": "recall",
      "q": "What spam complaint rate must bulk senders stay below under the 2024 Gmail and Yahoo rules?",
      "a": "0.3%, with 0.1% recommended.",
      "anchor": "#deliverability",
      "origin": "ai",
      "reviewed": false
    },
    {
      "id": "q2",
      "type": "explain",
      "q": "Why are automated sequences often the most effective emails?",
      "a": "They arrive when the reader is most interested, triggered by an action such as sign-up or an abandoned cart.",
      "anchor": "#automations",
      "origin": "ai",
      "reviewed": false
    },
    {
      "id": "q3",
      "type": "compare",
      "q": "How do EU and US rules differ on consent for marketing email?",
      "a": "The EU generally requires prior consent, with a narrow existing-customer exception; the US CAN-SPAM Act requires opt-out and accurate information but not prior consent.",
      "anchor": "#consent-and-law",
      "origin": "ai",
      "reviewed": false
    }
