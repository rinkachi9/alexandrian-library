  "concepts": [
    {
      "term": "Attribution",
      "anchor": "#definition",
      "definition": "The assignment of credit for a conversion to the touchpoints that preceded it."
    },
    {
      "term": "Campaign parameters",
      "anchor": "#tracking-basics",
      "definition": "UTM tags on links that tell analytics where a visit came from."
    },
    {
      "term": "Incrementality",
      "anchor": "#incrementality",
      "definition": "The conversions that happened because of the content and would not have happened otherwise."
    },
    {
      "term": "Leading indicator",
      "anchor": "#leading-and-lagging-indicators",
      "definition": "An early signal such as impressions or subscribers that predicts later results."
    }
  ],
  "questions": [
    {
      "id": "q1",
      "type": "recall",
      "q": "Which attribution models remained in GA4 after the 2023 change?",
      "a": "Data-driven and last click.",
      "anchor": "#attribution-models",
      "origin": "ai",
      "reviewed": false
    },
    {
      "id": "q2",
      "type": "explain",
      "q": "Why can no attribution model prove that content caused a sale?",
      "a": "Models only assign credit among observed touchpoints; buyers who would have bought anyway still credit the content they saw.",
      "anchor": "#attribution-models",
      "origin": "ai",
      "reviewed": false
    },
    {
      "id": "q3",
      "type": "apply",
      "q": "How would you estimate the effect of a newsletter on demo requests?",
      "a": "Run a holdout test: randomly withhold it from a share of subscribers and compare their demo request rate.",
      "anchor": "#incrementality",
      "origin": "ai",
      "reviewed": false
    }
  ],
