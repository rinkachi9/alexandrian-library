  "concepts": [
    {
      "term": "Private label",
      "anchor": "#definition",
      "definition": "A product manufactured by a third party and sold under the retailer's own brand."
    },
    {
      "term": "Minimum order quantity",
      "anchor": "#definition",
      "definition": "The smallest number of units a factory accepts per order."
    },
    {
      "term": "Manufacturer status",
      "anchor": "#private-label-compared-with-dropshipping",
      "definition": "In the EU, a business selling under its own name or brand is generally treated as the manufacturer."
    }
  ],
  "questions": [
    {
      "id": "q1",
      "type": "compare",
      "q": "Compare the upfront cost and risk of private label and dropshipping.",
      "a": "Private label needs design, samples and a minimum order in advance, so cost and risk are higher; dropshipping buys nothing before a sale.",
      "anchor": "#private-label-compared-with-dropshipping",
      "origin": "ai",
      "reviewed": false
    },
    {
      "id": "q2",
      "type": "explain",
      "q": "What makes a pre-sale demand test honest?",
      "a": "Labeling it as a pre-order with a realistic delivery date and offering a delay or refund choice if the date slips.",
      "anchor": "#testing-with-ads",
      "origin": "ai",
      "reviewed": false
    },
    {
      "id": "q3",
      "type": "recall",
      "q": "Name six costs of a private label launch that a dropshipper does not have.",
      "a": "Design, samples, tooling, the first batch at MOQ, branded packaging, freight and duties, certification and trademark registration.",
      "anchor": "#costs-to-plan-for",
      "origin": "ai",
      "reviewed": false
    }
