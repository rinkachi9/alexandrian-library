  "concepts": [
    {
      "term": "Dropshipping",
      "anchor": "#definition",
      "definition": "A fulfillment method in which a retailer sells products that a supplier stores and ships directly to the customer."
    },
    {
      "term": "Import One-Stop Shop",
      "anchor": "#cross-border-rules",
      "definition": "An optional EU scheme for collecting and declaring VAT on imported consignments worth up to 150 euros."
    },
    {
      "term": "Sourcing agent",
      "anchor": "#levels-of-dropshipping",
      "definition": "An intermediary near manufacturers who handles factory relations, quality checks and shipping."
    }
  ],
  "questions": [
    {
      "id": "q1",
      "type": "explain",
      "q": "Why is the dropshipper, not the supplier, responsible for a late delivery?",
      "a": "Because the customer's contract is with the retailer, and consumer law holds the seller answerable whoever ships the goods.",
      "anchor": "#responsibility-toward-customers",
      "origin": "ai",
      "reviewed": false
    },
    {
      "id": "q2",
      "type": "recall",
      "q": "When was the US de minimis exemption suspended for all countries?",
      "a": "From 29 August 2025, by Executive Order 14324.",
      "anchor": "#cross-border-rules",
      "origin": "ai",
      "reviewed": false
    }
  ],
