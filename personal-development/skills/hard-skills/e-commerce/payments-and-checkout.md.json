  "questions": [
    {
      "id": "q1",
      "type": "recall",
      "q": "What is the most common stated reason for abandoning checkout in Baymard's 2023 survey?",
      "a": "Extra costs too high (shipping, tax, fees), about 47%.",
      "anchor": "#why-shoppers-abandon",
      "origin": "ai",
      "reviewed": false
    },
    {
      "id": "q2",
      "type": "explain",
      "q": "How can a small shop reduce its PCI DSS scope?",
      "a": "Use hosted payment pages or embedded fields from the payment provider, so card numbers never touch its servers.",
      "anchor": "#card-data-security-pci-dss",
      "origin": "ai",
      "reviewed": false
    },
    {
      "id": "q3",
      "type": "recall",
      "q": "What must the EU order button say?",
      "a": "\"Order with obligation to pay\" or an equally unambiguous phrase.",
      "anchor": "#checkout-design-principles",
      "origin": "ai",
      "reviewed": false
    }
