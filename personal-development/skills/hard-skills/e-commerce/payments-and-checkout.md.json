  "concepts": [
    {
      "term": "Payment gateway",
      "anchor": "#definitions",
      "definition": "The service that captures payment details on a site and passes them on for authorization."
    },
    {
      "term": "Cart abandonment",
      "anchor": "#definitions",
      "definition": "Adding items to the cart and leaving without buying."
    },
    {
      "term": "Strong customer authentication",
      "anchor": "#strong-customer-authentication",
      "definition": "PSD2 requirement of two of three factors: knowledge, possession, inherence."
    },
    {
      "term": "Chargeback",
      "anchor": "#fees-fraud-and-chargebacks",
      "definition": "A reversal of a card payment initiated by the cardholder's bank."
    }
