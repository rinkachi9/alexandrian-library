  "concepts": [
    {
      "term": "Right of withdrawal",
      "anchor": "#legal-framework-in-the-eu",
      "definition": "The EU consumer right to withdraw from a distance purchase within 14 days without a reason."
    },
    {
      "term": "Service recovery paradox",
      "anchor": "#the-service-recovery-idea",
      "definition": "The contested claim that customers whose problem is solved well become more loyal than those without problems."
    },
    {
      "term": "Reverse logistics",
      "anchor": "#definition",
      "definition": "Receiving returned products, checking them, refunding and deciding what happens to them."
    }
  ],
  "questions": [
    {
      "id": "q1",
      "type": "recall",
      "q": "Within how many days must an EU seller refund after a withdrawal, and when may it withhold the refund?",
      "a": "Within 14 days of being informed; it may withhold until it receives the goods back or proof of return.",
      "anchor": "#legal-framework-in-the-eu",
      "origin": "ai",
      "reviewed": false
    },
    {
      "id": "q2",
      "type": "explain",
      "q": "Why should return reasons be recorded?",
      "a": "They reveal fixable causes such as poor size information, which reduces future returns.",
      "anchor": "#returns-economics",
      "origin": "ai",
      "reviewed": false
    },
    {
      "id": "q3",
      "type": "apply",
      "q": "Name three ways to reduce returns without restricting legal rights.",
      "a": "Precise size guides, accurate photos and descriptions, and reviews mentioning fit and quality.",
      "anchor": "#returns-economics",
      "origin": "ai",
      "reviewed": false
    }
