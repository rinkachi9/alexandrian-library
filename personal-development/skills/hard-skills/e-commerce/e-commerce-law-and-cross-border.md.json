  "concepts": [
    {
      "term": "One-Stop Shop",
      "anchor": "#vat-on-cross-border-sales",
      "definition": "An EU scheme for declaring VAT on cross-border sales in one member state."
    },
    {
      "term": "General Product Safety Regulation",
      "anchor": "#product-safety-and-compliance",
      "definition": "EU Regulation 2023/988, applying since 13 December 2024, on the safety of consumer products."
    },
    {
      "term": "European Accessibility Act",
      "anchor": "#accessibility",
      "definition": "EU Directive 2019/882, applying since 28 June 2025 to e-commerce services offered to consumers."
    },
    {
      "term": "De minimis exemption",
      "anchor": "#selling-to-the-united-states",
      "definition": "Duty-free entry for low-value imports, suspended in the US for all countries from August 2025."
    }
  ],
  "questions": [
    {
      "id": "q1",
      "type": "recall",
      "q": "Above what level of cross-border EU sales must a seller charge the customer's country VAT?",
      "a": "10,000 euros a year in total cross-border B2C sales.",
      "anchor": "#vat-on-cross-border-sales",
      "origin": "ai",
      "reviewed": false
    },
    {
      "id": "q2",
      "type": "recall",
      "q": "What changed for low-value imports into the EU on 1 July 2026?",
      "a": "A temporary flat customs duty of 3 euros per item category in low-value consignments began to apply.",
      "anchor": "#vat-on-cross-border-sales",
      "origin": "ai",
      "reviewed": false
    },
    {
      "id": "q3",
      "type": "explain",
      "q": "Why is a business selling under its own brand treated more strictly in product safety law?",
      "a": "It is generally treated as the manufacturer, with obligations for documentation, conformity and labeling.",
      "anchor": "#product-safety-and-compliance",
      "origin": "ai",
      "reviewed": false
    }
  ],
