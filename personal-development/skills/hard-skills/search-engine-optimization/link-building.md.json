  "questions": [
    {
      "id": "q1",
      "type": "explain",
      "q": "Why is ten links from one site worth less than ten links from ten relevant sites?",
      "a": "Ten links from one site count as one referring domain, and independent editorial links are stronger signals.",
      "anchor": "#definition",
      "origin": "ai",
      "reviewed": false
    },
    {
      "id": "q2",
      "type": "recall",
      "q": "When did Google start treating nofollow as a hint for crawling and indexing?",
      "a": "In March 2020, after announcing the change for ranking in September 2019.",
      "anchor": "#link-attributes",
      "origin": "ai",
      "reviewed": false
    },
    {
      "id": "q3",
      "type": "apply",
      "q": "What makes an outreach pitch for a link likely to succeed?",
      "a": "It is short, specific and shows what the recipient's readers gain, not what the sender wants.",
      "anchor": "#outreach",
      "origin": "ai",
