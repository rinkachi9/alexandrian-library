  "questions": [
    {
      "id": "q1",
      "type": "explain",
      "q": "Why is copying the manufacturer's product description bad for SEO?",
      "a": "Many shops publish the same text, so search engines have no reason to prefer your page.",
      "anchor": "#product-pages",
      "origin": "ai",
      "reviewed": false
    },
    {
      "id": "q2",
      "type": "apply",
      "q": "What should happen to the URL of a permanently discontinued product?",
      "a": "Redirect it with a 301 to the closest replacement or category, or return 404 or 410 if nothing fits.",
      "anchor": "#product-variants-and-out-of-stock-items",
      "origin": "ai",
      "reviewed": false
    },
    {
      "id": "q3",
      "type": "explain",
      "q": "Which filter pages should be indexable?",
      "a": "Only a few that match real searches with demand, each with its own title and introduction.",
      "anchor": "#duplicate-urls-and-faceted-navigation",
      "origin": "ai",
      "reviewed": false
    }
  ],
