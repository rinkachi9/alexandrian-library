    {
      "term": "Faceted navigation",
      "anchor": "#duplicate-urls-and-faceted-navigation",
      "definition": "Filters on a category page whose combinations can each create a separate URL."
    },
    {
      "term": "Duplicate content",
      "anchor": "#product-pages",
      "definition": "The same text on many pages or sites, such as manufacturer descriptions copied by many shops."
    },
