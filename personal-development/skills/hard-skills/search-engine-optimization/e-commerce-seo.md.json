      "id": "q1",
      "type": "explain",
      "q": "Why is copying the manufacturer's product description bad for SEO?",
      "a": "Many shops publish the same text, so it is duplicate content and gives the search engine no reason to prefer your page.",
      "anchor": "#product-pages",
      "origin": "ai",
      "reviewed": false
    },
    {
      "id": "q2",
      "type": "apply",
      "q": "What should happen to the URL of a permanently discontinued product?",
      "a": "Redirect it with a 301 to the closest replacement or category, or return 404 or 410 if nothing fits; avoid redirecting everything to the home page.",
      "anchor": "#product-variants-and-out-of-stock-items",
      "origin": "ai",
      "reviewed": false
