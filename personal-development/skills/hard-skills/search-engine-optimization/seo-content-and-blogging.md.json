      "type": "explain",
      "q": "Why may refreshing and merging old pages gain more than publishing new ones?",
      "a": "Old pages already have history and links; updating them fixes decay and merging removes cannibalization.",
      "anchor": "#maintenance-and-updates",
      "origin": "ai",
      "reviewed": false
    },
