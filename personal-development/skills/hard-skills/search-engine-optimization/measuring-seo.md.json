  "questions": [
    {
      "id": "q1",
      "type": "explain",
      "q": "Why can average position be misleading?",
      "a": "It averages over all impressions and queries, so a mix of high and low positions produces a number that describes neither.",
      "anchor": "#understanding-the-metrics",
      "origin": "ai",
      "reviewed": false
    },
    {
      "id": "q2",
      "type": "recall",
      "q": "Name the five checks when organic traffic changes.",
      "a": "Scope, indexing problems or manual actions, timing of updates and own changes, seasonality, and SERP feature changes.",
      "anchor": "#algorithm-updates-and-volatility",
      "origin": "ai",
      "reviewed": false
    },
    {
      "id": "q3",
      "type": "explain",
      "q": "Why is the unit of randomization different in SEO tests than in A/B tests?",
      "a": "Search engines see one version of each page, so SEO tests randomize groups of pages, not visitors.",
      "anchor": "#estimating-the-effect-of-seo-changes",
      "origin": "ai",
      "reviewed": false
