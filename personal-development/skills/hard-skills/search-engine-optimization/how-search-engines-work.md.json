  "concepts": [
    {
      "term": "Search engine optimization",
      "anchor": "#definition-of-seo",
      "definition": "Improving a site and its content so that it appears higher and more often in unpaid search results."
    },
    {
      "term": "Crawling",
      "anchor": "#stage-1-crawling",
      "definition": "Discovering and downloading pages by following links and reading sitemaps."
    },
    {
      "term": "Index",
      "anchor": "#stage-2-rendering-and-indexing",
      "definition": "The search engine's database of pages it has processed and may show in results."
    },
    {
      "term": "E-E-A-T",
      "anchor": "#quality-guidelines-and-spam-policies",
      "definition": "Experience, expertise, authoritativeness and trustworthiness, concepts from Google's quality rater guidelines."
    }
  ],
  "questions": [
    {
      "id": "q1",
      "type": "explain",
      "q": "Why can a URL blocked in robots.txt still appear in results?",
      "a": "Robots.txt controls crawling, not indexing; if other pages link to the URL, it can be indexed without its content.",
      "anchor": "#stage-1-crawling",
      "origin": "ai",
      "reviewed": false
    },
    {
      "id": "q2",
      "type": "recall",
      "q": "Which three spam policies did Google add in March 2024?",
      "a": "Scaled content abuse, site reputation abuse and expired domain abuse.",
      "anchor": "#quality-guidelines-and-spam-policies",
      "origin": "ai",
      "reviewed": false
    },
    {
      "id": "q3",
      "type": "recall",
      "q": "Since when does Google crawl all sites only with its smartphone crawler?",
      "a": "Since July 2024 (after 5 July 2024).",
      "anchor": "#stage-1-crawling",
      "origin": "ai",
      "reviewed": false
    }
