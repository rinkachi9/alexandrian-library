  "questions": [
    {
      "id": "q1",
      "type": "compare",
      "q": "How do noindex and a robots.txt disallow rule differ?",
      "a": "Robots.txt stops crawling but a blocked URL can still be indexed; noindex stops a crawled page from appearing in results, so the page must not be blocked.",
      "anchor": "#indexing-control",
      "origin": "ai",
      "reviewed": false
    },
    {
      "id": "q2",
      "type": "recall",
      "q": "Which metric replaced First Input Delay as a Core Web Vital, and when?",
      "a": "Interaction to Next Paint (INP), on 12 March 2024.",
      "anchor": "#technical-seo",
      "origin": "ai",
      "reviewed": false
    },
    {
      "id": "q3",
      "type": "explain",
      "q": "Why is 'LSI keywords' a misleading name?",
      "a": "Latent semantic indexing is a 1980s retrieval method that Google says it does not use; the useful idea is to cover related terms that describe the topic.",
      "anchor": "#related-terms-and-the-lsi-myth",
      "origin": "ai",
      "reviewed": false
    }
  ],
