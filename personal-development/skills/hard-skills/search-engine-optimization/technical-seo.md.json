  "concepts": [
    {
      "term": "Technical SEO",
      "anchor": "#definition",
      "definition": "Site and server optimizations that affect how search engines access, understand and evaluate a website."
    },
    {
      "term": "Canonical URL",
      "anchor": "#indexing-control",
      "definition": "The main version of a set of duplicate URLs, named with a rel=\"canonical\" link."
    },
    {
      "term": "Core Web Vitals",
      "anchor": "#core-web-vitals",
      "definition": "Google's page experience metrics: LCP, INP and CLS."
    },
    {
      "term": "Redirect chain",
      "anchor": "#http-status-codes-and-redirects",
      "definition": "A sequence of redirects from one URL through others to the final URL."
    }
  ],
  "questions": [
    {
      "id": "q1",
      "type": "recall",
      "q": "What are the \"good\" thresholds for LCP, INP and CLS?",
      "a": "LCP 2.5 seconds or less, INP 200 milliseconds or less, CLS 0.1 or less, at the 75th percentile.",
      "anchor": "#core-web-vitals",
      "origin": "ai",
      "reviewed": false
    },
    {
      "id": "q2",
      "type": "explain",
      "q": "Why is server-side rendering safer for important content than client-side JavaScript?",
      "a": "The content is in the HTML response, so it does not depend on rendering that can be delayed or fail.",
      "anchor": "#javascript-and-rendering",
      "origin": "ai",
      "reviewed": false
    },
    {
      "id": "q3",
      "type": "apply",
      "q": "What must be prepared before changing a site's URL structure?",
      "a": "A map of every old URL to its new URL, with direct 301 redirects, updated internal links, canonicals and sitemaps.",
      "anchor": "#worked-example",
      "origin": "ai",
      "reviewed": false
    }
  ],
