  "concepts": [
    {
      "term": "Hard skill",
      "anchor": "#definition",
      "definition": "A learned, task-specific ability whose correct performance can be described by explicit criteria and tested."
    },
    {
      "term": "T-shaped profile",
      "anchor": "#depth-and-breadth",
      "definition": "One deep skill combined with a broad working knowledge of neighboring ones."
    },
    {
      "term": "Skill obsolescence",
      "anchor": "#skill-obsolescence",
      "definition": "The loss of value of a skill as tools, methods or rules change."
    }
  ],
  "questions": [
    {
      "id": "q1",
      "type": "explain",
      "q": "Why is a portfolio often stronger evidence than a certificate in digital fields?",
      "a": "A portfolio shows real work and current ability, while a certificate shows that a standard was met once.",
      "anchor": "#how-hard-skills-are-assessed",
      "origin": "ai",
      "reviewed": false
    },
    {
      "id": "q2",
      "type": "apply",
      "q": "Which four sources would you combine to choose a hard skill to learn?",
      "a": "Labor market data, your goals and strengths, complementarity with existing skills, and durability.",
      "anchor": "#choosing-which-hard-skills-to-learn",
      "origin": "ai",
      "reviewed": false
    },
    {
      "id": "q3",
      "type": "explain",
      "q": "What is the tutorial loop and how do you escape it?",
      "a": "Following tutorials without building anything alone; escape by producing work products without step-by-step instructions.",
      "anchor": "#how-hard-skills-are-learned",
      "origin": "ai",
      "reviewed": false
    }
