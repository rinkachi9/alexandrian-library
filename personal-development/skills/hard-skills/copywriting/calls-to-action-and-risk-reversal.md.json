  "concepts": [
    {
      "term": "Call to action",
      "anchor": "#call-to-action",
      "definition": "A short instruction, usually a button or link, that names the reader's next step."
    },
    {
      "term": "Risk reversal",
      "anchor": "#risk-reversal",
      "definition": "Moving the risk of a bad purchase from the buyer to the seller, or reducing it."
    },
    {
      "term": "Legal guarantee of conformity",
      "anchor": "#guarantees-and-the-law",
      "definition": "The seller's liability in the EU for goods that do not conform to the contract, for at least two years."
    }
  ],
