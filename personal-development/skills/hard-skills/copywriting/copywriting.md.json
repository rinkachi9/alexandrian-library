  "concepts": [
    {
      "term": "Copywriting",
      "anchor": "#definition",
      "definition": "Writing persuasive text whose purpose is to make a specific reader take a specific action."
    },
    {
      "term": "Benefit",
      "anchor": "#features-and-benefits",
      "definition": "What a product feature does for the reader, as opposed to the fact about the product."
    },
    {
      "term": "AIDA",
      "anchor": "#structures",
      "definition": "Attention, Interest, Desire, Action: a structure that moves a reader from noticing to acting."
    }
  ],
