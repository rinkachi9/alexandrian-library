  "questions": [
    {
      "id": "q1",
      "type": "explain",
      "q": "What do readability formulas fail to measure?",
      "a": "Whether the text is clear, correct and logically organized; they only measure surface features such as sentence and word length.",
      "anchor": "#readability",
      "origin": "ai",
      "reviewed": false
    },
    {
      "id": "q2",
      "type": "apply",
      "q": "Rewrite the error message \"Invalid input\" for a card number field.",
      "a": "For example: \"The card number has 15 digits. Please check the last digit.\"",
      "anchor": "#microcopy",
      "origin": "ai",
      "reviewed": false
    },
    {
      "id": "q3",
      "type": "recall",
      "q": "Name four focuses of separate editing passes.",
      "a": "Purpose, structure, claims, sentences, words, reading aloud and proofreading.",
