  "concepts": [
    {
      "term": "Copywriting",
      "anchor": "#definition",
      "definition": "Writing persuasive text whose purpose is to make a specific reader take a specific action."
    },
    {
      "term": "Direct response copywriting",
      "anchor": "#definition",
      "definition": "Copy that asks for an immediate, measurable action and is judged by the response rate."
    },
    {
      "term": "Voice",
      "anchor": "#voice",
      "definition": "The stable character of a brand's writing, such as formal or casual, serious or playful."
    },
    {
      "term": "Substantiation",
      "anchor": "#legal-limits",
      "definition": "Having a reasonable basis for objective advertising claims before making them."
    }
  ],
