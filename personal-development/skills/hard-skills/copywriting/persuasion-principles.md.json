  "concepts": [
    {
      "term": "Social proof",
      "anchor": "#social-proof",
      "definition": "The tendency to use other people's behavior as evidence of what is correct, especially under uncertainty."
    },
    {
      "term": "Scarcity",
      "anchor": "#scarcity",
      "definition": "The tendency to value things more when they are rare or becoming unavailable."
    },
    {
      "term": "Anchoring",
      "anchor": "#anchoring",
      "definition": "The influence of an initial number on a later estimate, even when the number is irrelevant."
    },
    {
      "term": "Dark pattern",
      "anchor": "#ethics-and-dark-patterns",
      "definition": "An interface design that steers users into decisions they would not otherwise make."
    }
  ],
