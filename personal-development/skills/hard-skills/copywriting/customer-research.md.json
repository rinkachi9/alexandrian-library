  "concepts": [
    {
      "term": "Voice of customer",
      "anchor": "#definition",
      "definition": "The collected phrases customers use to describe their situation, problems and goals."
    },
    {
      "term": "Review mining",
      "anchor": "#review-mining",
      "definition": "A structured reading of reviews to extract recurring themes and exact phrases."
    },
    {
      "term": "Jobs to be done",
      "anchor": "#jobs-to-be-done",
      "definition": "The progress a customer is trying to make in a particular circumstance, for which they hire a product."
    },
    {
      "term": "Awareness levels",
      "anchor": "#awareness-levels",
      "definition": "Schwartz's five stages from unaware to most aware, which decide where copy should start."
    }
