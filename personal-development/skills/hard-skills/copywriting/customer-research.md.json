      "id": "q2",
      "type": "apply",
      "q": "Where should copy start for a solution-aware reader?",
      "a": "With what a good solution must do, showing why this solution meets that standard.",
      "anchor": "#awareness-levels",
      "origin": "ai",
      "reviewed": false
    },
    {
      "id": "q3",
      "type": "recall",
      "q": "What seven items does a message map contain?",
      "a": "Reader, job, main promise, proof points, top objections with answers, key phrases, awareness stage and opening.",
